{% doc %}
  @prompt
    create a three grid blog post display. allow for individual selection also allow for category selection

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-blog-grid-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-blog-grid-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom:40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-blog-grid-posts-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-blog-post-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-blog-post-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .ai-blog-post-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-blog-post-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-post-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-post-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-blog-post-content-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-blog-post-date-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.date_color }};
    margin-bottom: 8px;
    text-transform: uppercase;letter-spacing: 0.5px;
  }

  .ai-blog-post-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .ai-blog-post-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-blog-post-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.title_hover_color }};
  }

  .ai-blog-post-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .ai-blog-post-read-more-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.read_more_color }};
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .ai-blog-post-read-more-{{ ai_gen_id }}:hover {
    border-bottom-color: {{ block.settings.read_more_color }};
  }

  .ai-blog-grid-empty-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.excerpt_color }};
  }

  @media screen and (max-width: 990px) {
    .ai-blog-grid-posts-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-grid-posts-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-blog-grid-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-blog-post-content-{{ ai_gen_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<div class="ai-blog-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-blog-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-blog-grid-posts-{{ ai_gen_id }}">
      {% liquid
        assign articles_to_show = ''
        assign articles_array = ''

        if block.settings.selection_type == 'individual'
          if block.settings.article_1 != blank
            assign articles_array = articles_array | append: block.settings.article_1.id | append: ','
          endif
          if block.settings.article_2 != blank
            assign articles_array = articles_array | append: block.settings.article_2.id | append: ','
          endif
          if block.settings.article_3 != blank
            assign articles_array = articles_array | append: block.settings.article_3.id | append: ','
          endif
          assign articles_ids = articles_array | split: ','
          for article_id in articles_ids
            if article_id != blank
              assign article = blogs[blog.handle].articles[article_id] | default: articles[article_id]
              if article != blank
                assign articles_to_show = articles_to_show | append: article.id | append: ','
              endif
            endif
          endfor
        else
          if block.settings.blog_selection != blank
            assign selected_blog = block.settings.blog_selection
            assign articles_to_show = selected_blog.articles | map: 'id' | join: ','
          endif
        endif

        assign final_articles = ''
        if articles_to_show != blank
          assign article_ids = articles_to_show | split: ','
          assign count = 0
          for article_id in article_ids
            if count < 3 and article_id != blank
              assign article = articles[article_id]
              if article != blank
                assign final_articles = final_articles | append: article.id | append: ','
                assign count = count | plus: 1
              endif
            endif
          endfor
        endif
      %}

      {% if final_articles != blank %}
        {% assign final_article_ids = final_articles | split: ',' %}
        {% for article_id in final_article_ids limit: 3 %}
          {% if article_id != blank %}
            {% assign article = articles[article_id] %}
            {% if article != blank %}<article class="ai-blog-post-card-{{ ai_gen_id }}">
                <div class="ai-blog-post-image-{{ ai_gen_id }}">
                  {% if article.image %}
                    <img
                      src="{{ article.image | image_url: width: 600 }}"
                      alt="{{ article.image.alt | escape }}"
                      loading="lazy"
                width="600"
                      height="{{ block.settings.image_height }}"
                    >
                  {% else %}
                    <div class="ai-blog-post-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                
                <div class="ai-blog-post-content-{{ ai_gen_id }}">
                  {% if block.settings.show_date %}
                    <div class="ai-blog-post-date-{{ ai_gen_id }}">
                      {{ article.published_at | date: '%B %d, %Y' }}
                    </div>
                  {% endif %}  <h3 class="ai-blog-post-title-{{ ai_gen_id }}">
                    <a href="{{ article.url }}">{{ article.title }}</a>
                  </h3>{% if block.settings.show_excerpt and article.excerpt != blank %}
                    <div class="ai-blog-post-excerpt-{{ ai_gen_id }}">
                      {{ article.excerpt | strip_html | truncate: 120 }}
                    </div>
                  {% endif %}{% if block.settings.show_read_more %}
                    <a href="{{ article.url }}" class="ai-blog-post-read-more-{{ ai_gen_id }}">
                      {{ block.settings.read_more_text }}
                    </a>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="ai-blog-grid-empty-{{ ai_gen_id }}">
          <p>No articles selected. Please configure the blog posts in the theme editor.</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest articles"
    },
    {
      "type": "select",
      "id": "selection_type",
      "label": "Selection type",
      "options": [
        {
          "value": "individual",
          "label": "Individual articles"
        },
        {
          "value": "blog",
          "label": "From blog"
        }
      ],
      "default": "individual"
    },
    {
      "type": "blog",
      "id": "blog_selection",
      "label": "Blog"
    },
    {
      "type": "article",
      "id": "article_1",
      "label": "Article 1"
    },
    {
      "type": "article",
      "id": "article_2",
      "label": "Article 2"
    },
    {
      "type": "article",
      "id": "article_3",
      "label": "Article 3"
    },
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "Show read more link",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Read more"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Grid gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 240
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#e6e6e6"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Article title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_hover_color",
      "label": "Article title hover color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Article title size",
      "default": 20
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "excerpt_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Excerpt size",
      "default": 14
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "read_more_color",
      "label": "Read more color",
      "default": "#000f9f"
    }
  ],
  "presets": [
    {
      "name": "Blog grid"
    }
  ]
}
{% endschema %}