      "max": 150,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Section Padding (px)",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 100
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "OUR TRAILBLAZERS"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (px)",
      "min": 24,
      "max": 72,
      "step": 1,
      "default": 48
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Width (px)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "default": 600
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height (px)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "default": 400
    },
    {
      "type": "image_picker",
      "id": "logo_watermark_behind",
      "label": "Logo Watermark Behind Founders"
    },
  ],
  "blocks": [
    {
      "type": "quote_card",
      "name": "Quote Card",
      "settings": [
        {
          "type": "range",
          "id": "card_width",
          "label": "Card Width (px)",
          "min": 100,
          "max": 500,
          "step": 10,
          "default": 300
        },
        {
          "type": "image_picker",
          "id": "card_texture_image",
          "label": "Card Background Image"
        },
        {
          "type": "image_picker",
          "id": "tape_image",
          "label": "Tape Image"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>\"Share a memorable quote here.\"</p>"
        },
        {
          "type": "range",
          "id": "quote_font_size",
          "label": "Quote Font Size (px)",
          "min": 12,
          "max": 36,
          "step": 1,
          "default": 16
        },
        {
          "type": "select",
          "id": "quote_font_weight",
          "label": "Quote Font Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "400"
        },
        {
          "type": "color",
          "id": "quote_color",
          "label": "Quote Color",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Name"
        },
        {
          "type": "range",
          "id": "name_font_size",
          "label": "Name Font Size (px)",
          "min": 12,
          "max": 36,
          "step": 1,
          "default": 14
        },
        {
          "type": "select",
          "id": "name_font_weight",
          "label": "Name Font Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "700"
        },
        {
          "type": "color",
          "id": "name_color",
          "label": "Name Font Color",
          "default": "#000000"
        },
        {
          "type": "text",
          "id": "designation",
          "label": "Designation",
          "default": "Co-founder & Director"
        },
        {
          "type": "range",
          "id": "designation_font_size",
          "label": "Designation Font Size (px)",
          "min": 10,
          "max": 24,
          "step": 1,
          "default": 12
        },
        {
          "type": "select",
          "id": "designation_font_weight",
          "label": "Designation Font Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "400"
        },
        {
          "type": "color",
          "id": "designation_color",
          "label": "Designation Font Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "card_rotation",
          "label": "Card Rotation (degrees)",
          "min": -30,
          "max": 30,
          "step": 1,
          "default": 0
        },
        {
          "type": "range",
          "id": "horizontal_position",
          "label": "Horizontal Position (px)",
          "min": -500,
          "max": 500,
          "step": 10,
          "default": 0,
          "info": "Positive values move right, negative values move left"
        },
        {
          "type": "range",
          "id": "vertical_position",
          "label": "Vertical Position (px)",
          "min": -500,
          "max": 500,
          "step": 10,
          "default": 0,
          "info": "Positive values move down, negative values move up"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Trailblazers",
      "category": "Custom Content"
