<style>
  /* Base section styling */
  .our-trailblazers-section {
    position: relative;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  /* Main element styling */
  .main-container {
    width: 1200px;
    display: flex;
    justify-content: center;
    position: relative; /* positional context for absolute children */
    margin: 0 auto;
    max-width: 100%;
  }

  /* Logo Watermark - Positioned relative to .main-container */
.logo-watermark-wrapper {   
 position: absolute;   
  width: 234px; /* Adjust based on your logo's actual proportions */     
  height: 475px; /* Maintain the ratio of your logo */   
  top: -25px;    
  right: 75px;    
  z-index: 1; 
}    
.logo-watermark {
  width: 100%;     
  height: 100%;      
  object-fit: contain;
  display: block;
}

  /* Title container and styling */
  .section-title-container {
    text-align: center;
    position: relative;
    z-index: 2;
    margin-bottom: 50px;
  }

  .section-title-container h2 {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    margin: 0;
  }

  /* Founders image */
  .founders-image {
    position: relative;
    z-index: 3;
    display: block;
    margin: 0 auto;
    width: {{ section.settings.image_width }}px;
    height: {{ section.settings.image_height }}px;
    object-fit: cover;
    border-radius: 8px;
  }

  /* CSS for quote cards */
  .quote-card {
    position: absolute;
    z-index: 4;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 4px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }

  /* Dynamic quote card styling */
  {% for block in section.blocks %}
    {% if block.type == 'quote_card' %}
      .quote-card.card-{{ forloop.index }} {
        width: {{ block.settings.card_width }}px;
        top: calc(50% + {{ block.settings.vertical_position }}px);
        left: calc(50% + {{ block.settings.horizontal_position }}px);
        transform: translate(-50%, -50%) rotate({{ block.settings.card_rotation }}deg);
        {% if block.settings.card_texture_image %}
          background-image: url('{{ block.settings.card_texture_image | image_url }}');
        {% endif %}
      }

      .quote-card.card-{{ forloop.index }} .quote-card-quote {
        font-size: {{ block.settings.quote_font_size }}px;
        font-weight: {{ block.settings.quote_font_weight }};
        color: {{ block.settings.quote_color }};
        line-height: 1.4;
        margin-bottom: 15px;
      }

      .quote-card.card-{{ forloop.index }} .quote-card-name {
        font-size: {{ block.settings.name_font_size }}px;
        font-weight: {{ block.settings.name_font_weight }};
        color: {{ block.settings.name_color }};
        line-height: 1.2;
        margin: 0;
      }

      .quote-card.card-{{ forloop.index }} .quote-card-designation {
        font-size: {{ block.settings.designation_font_size }}px;
        font-weight: {{ block.settings.designation_font_weight }};
        color: {{ block.settings.designation_color }};
        line-height: 1.2;
        margin: 5px 0 0 0;
      }
    {% endif %}
  {% endfor %}

 
</style>

<div class="our-trailblazers-section">
  <div class="section-title-container">
    <h2>{{ section.settings.title }}</h2>
  </div>

  <div class="main-container">
    {% if section.settings.center_image %}
      <img src="{{ section.settings.center_image | image_url }}" alt="Founders Image" class="founders-image">
    {% endif %}

    {% if section.settings.logo_watermark_behind %}
      <div class="logo-watermark-wrapper">
        <img src="{{ section.settings.logo_watermark_behind | image_url }}" alt="Logo Watermark" class="logo-watermark">
      </div>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == 'quote_card' %}
        <div class="quote-card card-{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% if block.settings.tape_image %}
            <img src="{{ block.settings.tape_image | image_url }}" alt="Tape" class="card-tape tape-{{ forloop.index }}">
          {% endif %}
          <div class="quote-card-content">
            <p class="quote-card-quote">{{ block.settings.quote | strip_html | replace: '\"', '"' }}</p>
            <p class="quote-card-name">{{ block.settings.name }}</p>
            <p class="quote-card-designation">{{ block.settings.designation }}</p>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>


{% schema %}
{
  "name": "Our Trailblazers",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
