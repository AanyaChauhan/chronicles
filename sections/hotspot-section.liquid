<script>
(function () {
  const initHotspotSplit = () => {
    const section = document.querySelector('.hotspot-split-section');
    if (!section) return;

    const isMobile = window.innerWidth <= 989;
    
    if (typeof Swiper === 'undefined') {
      console.error('Swiper library not loaded');
      return;
    }

    if (isMobile) {
      // Initialize mobile Swiper
      const mobileSwiper = new Swiper('.hotspot-swiper-mobile', {
        slidesPerView: 1,
        spaceBetween: 0,
        speed: 600,
        loop: true,
        navigation: {
          nextEl: '.hotspot-mobile-view .swiper-button-next-custom',
          prevEl: '.hotspot-mobile-view .swiper-button-prev-custom',
          disabledClass: 'swiper-button-disabled-custom',
        },
        on: {
          slideChange: function() {
            const allMarkers = section.querySelectorAll('.product-markers__item.active');
            allMarkers.forEach(marker => marker.classList.remove('active'));
          }
        }
      });
    } else {
      // Initialize desktop Swiper
      const desktopSwiper = new Swiper('.hotspot-swiper', {
        slidesPerView: 1,
        spaceBetween: 0,
        speed: 600,
        loop: true,
        on: {
          slideChange: function() {
            const allMarkers = section.querySelectorAll('.product-markers__item.active');
            allMarkers.forEach(marker => marker.classList.remove('active'));
          }
        }
      });
    }
    
    // Color swatch functionality
    initColorSwatches();
  };
  
  const initColorSwatches = () => {
    const swatchContainers = document.querySelectorAll('.card-horizontal-wrapper');
    
    swatchContainers.forEach(container => {
      const swatches = container.querySelectorAll('.product-card__swatch, .product-card__swatch-item');
      
      if (swatches.length === 0) return;
      
      // Remove all active classes first
      swatches.forEach(swatch => swatch.classList.remove('active'));
      
      // Add active class to first swatch only
      if (swatches[0]) {
        swatches[0].classList.add('active');
      }
      
      // Add click handlers
      swatches.forEach((swatch, index) => {
        swatch.addEventListener('click', function(e) {
          e.preventDefault();
          
          // Remove active from all swatches in this container
          swatches.forEach(s => s.classList.remove('active'));
          
          // Add active to clicked swatch
          this.classList.add('active');
        });
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHotspotSplit);
  } else {
    initHotspotSplit();
  }

  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(initHotspotSplit, 250);
  });

  if (typeof Shopify !== 'undefined' && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (event) {
      if (event.target.classList.contains('hotspot-split-section')) {
        setTimeout(initHotspotSplit, 100);
      }
    });
  }
})();
</script>

