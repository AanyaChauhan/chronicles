        <img src="{{ section.settings.logo_image | img_url: '200x' }}" alt="Logo" class="logo-img">
      </div>
    {% endif %}

    <div class="main-text-wrapper">
      {%- assign text = section.settings.main_text -%}
      {% assign highlight_words = "memory,contemporary" | split: "," %}
      {% assign highlighted_text = text %}
      {% for word in highlight_words %}
        {% capture highlighted_word %}
          <span class="highlighted">{{ word }}</span>
        {% endcapture %}
        {% assign highlighted_text = highlighted_text | replace: word, highlighted_word %}
      {% endfor %}
      <div class="main-heading-text" style="
        color: {{ section.settings.text_color }};
        font-family: '{{ section.settings.text_font }}', serif;
        font-size: {{ section.settings.font_size }}px;
      ">
        {{ highlighted_text | raw }}
      </div>
    </div>
    
    <div class="btn-wrapper">
      <a href="javascript:void(0);" id="klaviyo_form_trigger_memory" class="know-story-btn"
        style="
          background: transparent;
          color: {{ section.settings.btn_color }};
          font-family: 'Archivo', sans-serif;
          font-weight: 300;
          font-size: 14px;
          line-height: 24px;
          letter-spacing: 0;
        "
      >
        {{ section.settings.btn_text }}
      </a>
    </div>
  </div>

