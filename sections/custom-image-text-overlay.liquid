<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollTrigger.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/DrawSVGPlugin.min.js"></script>

<script>
(function() {
  // Register GSAP plugins
  gsap.registerPlugin(ScrollTrigger, DrawSVGPlugin);

  const section = document.querySelector('.custom-memory-section');
  if (!section) return;

  // Get configuration from data attributes
  const animationDuration = parseFloat(section.dataset.animationDuration) || 1.2;
  const animationStart = section.dataset.animationStart || 'top 75%';

  let currentBreakpoint = null;
  let animations = [];

  // Helper function to check if element is visible
  function isVisible(element) {
    return element && window.getComputedStyle(element).display !== 'none';
  }

  // Helper function to get current breakpoint
  function getCurrentBreakpoint() {
    return window.innerWidth <= 768 ? 'mobile' : 'desktop';
  }

  // Helper function to sort SVG elements top-to-bottom, then left-to-right (or right-to-left)
  function sortElements(elements, isRightSide = false) {
    return Array.from(elements).sort((a, b) => {
      const aBox = a.getBBox();
      const bBox = b.getBBox();
      
      // First sort by top position (Y coordinate)
      const yDiff = aBox.y - bBox.y;
      if (Math.abs(yDiff) > 10) return yDiff;
      
      // Then sort by left/right position (X coordinate)
      return isRightSide ? (bBox.x - aBox.x) : (aBox.x - bBox.x);
    });
  }

  // Create animations for visible SVGs
  function createAnimations() {
    // Kill existing animations
    animations.forEach(anim => anim.kill());
    animations = [];
    ScrollTrigger.getAll().forEach(st => st.kill());

    const breakpoint = getCurrentBreakpoint();
    const leftSvg = document.querySelector(`.side-deco-left.side-deco-${breakpoint}`);
    const rightSvg = document.querySelector(`.side-deco-right.side-deco-${breakpoint}`);

    // Animate left side SVG
    if (leftSvg && isVisible(leftSvg)) {
      const leftElements = leftSvg.querySelectorAll('path, rect, circle, line, polyline, polygon');
      const sortedLeft = sortElements(leftElements, false);
      
      // Set initial state
      gsap.set(sortedLeft, { drawSVG: '0%' });
      
      // Create animation
      const leftTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: animationStart,
          once: true,
          markers: false
        }
      });
      
      leftTimeline.to(sortedLeft, {
        drawSVG: '100%',
        duration: animationDuration,
        stagger: 0.06,
        ease: 'power2.inOut'
      });
      
      animations.push(leftTimeline);
    }

    // Animate right side SVG
    if (rightSvg && isVisible(rightSvg)) {
      const rightElements = rightSvg.querySelectorAll('path, rect, circle, line, polyline, polygon');
      const sortedRight = sortElements(rightElements, true);
      
      // Set initial state
      gsap.set(sortedRight, { drawSVG: '0%' });
      
      // Create animation
      const rightTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: animationStart,
          once: true,
          markers: false
        }
      });
      
      rightTimeline.to(sortedRight, {
        drawSVG: '100%',
        duration: animationDuration,
        stagger: 0.06,
        ease: 'power2.inOut'
      });
      
      animations.push(rightTimeline);
    }

    currentBreakpoint = breakpoint;
  }

  // Debounce function
  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Handle resize with breakpoint detection
  const handleResize = debounce(() => {
    const newBreakpoint = getCurrentBreakpoint();
    
    // Only recreate animations if breakpoint changed
    if (newBreakpoint !== currentBreakpoint) {
      createAnimations();
    }
  }, 200);

  // Initialize animations after a short delay
  setTimeout(() => {
    createAnimations();
  }, 80);

  // Listen for window resize
  window.addEventListener('resize', handleResize);
})();

// Klaviyo popup trigger
document.getElementById('klaviyo_form_trigger_memory').addEventListener('click', function () {
  window._klOnsite = window._klOnsite || [];
  window._klOnsite.push(['openForm', 'Rs2AUU']);
});
</script>