<style>
.custom-memory-section {
  min-height: 450px;
  display: flex;
  align-items: stretch;
  justify-content: center;
  position: relative;
}
.section-inner-wrapper {
  margin: 0 auto;
  min-height: 450px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 72px 16px 40px 16px;
  padding-bottom: 149px;
}
.logo-wrapper {
  margin-bottom: 103px;
}
.logo-img {
  width: 105.24px;
  height: 135.02px;
  display: block;
  margin: 0 auto;
}
.main-text-wrapper {
  margin-bottom: 45.54px;
  max-width: 1100px;
}
.main-heading-text {
  font-style: italic;
  font-weight: 400;
  line-height: 1.21;
}
.highlighted {
  color: #FF7A56;
  font-style: italic;
  font-family: inherit;
}
.btn-wrapper {
  margin-top: 12px;
  display: flex;
  justify-content: center;
}
.know-story-btn {
  display: inline-block;
  padding: 12px 18px;
  border: 1px solid #FFF8E3;
  background: transparent;
  color: #FFF8E3;
  font-family: 'Archivo', sans-serif;
  font-weight: 300;
  font-size: 14px;
  letter-spacing: 0;
  text-transform: uppercase;
  text-align: center;
  cursor: pointer;
  box-sizing: border-box;
  position: relative;
  transition: color 0.35s cubic-bezier(.4,0,.2,1), background 0.35s cubic-bezier(.4,0,.2,1);
  overflow: hidden;
}
.know-story-btn::before {
  content: '';
  position: absolute;
