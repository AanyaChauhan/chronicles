{% schema %}
{
  "name": "Custom Image Text Overlay",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#48452A"
    },
    {
      "type": "image_picker",
      "id": "texture_image",
      "label": "Texture Image"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "textarea",
      "id": "main_text",
      "label": "Main Heading Text",
      "default": "This is a house of memory, where Bidriware, light, and ritual come together to create timeless objects for contemporary living."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFF8E3"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Text Color",
      "default": "#FF7A56"
    },
    {
      "type": "select",
      "id": "text_font",
      "label": "Text Font",
      "options": [
        {"value":"Playfair Display", "label":"Playfair Display"},
        {"value":"Serif", "label":"Serif"},
        {"value":"Sans-serif", "label":"Sans-serif"},
        {"value":"Archivo", "label":"Archivo"}
      ],
      "default": "Playfair Display"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "KNOW OUR STORY"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (px)",
      "min": 32,
      "max": 60,
      "step": 2,
      "default": 48
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Text Color",
      "default": "#FFF8E3"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#48452A"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "SVG Animation Duration (seconds)",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "text",
      "id": "animation_start",
      "label": "Animation Start Position",
      "default": "top 80%",
      "info": "ScrollTrigger start position (e.g., 'top 80%', 'center center')"
    }
  ],
  "presets": [
    {
      "name": "Custom Image Text Overlay",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="custom-memory-section"
  style="
    background: {{ section.settings.bg_color }};
    {% if section.settings.texture_image != blank %}
      background-image: url({{ section.settings.texture_image | img_url: '1500x' }});
      background-size: cover;
    {% endif %}
    position: relative;
    overflow: hidden;
  "
  data-animation-duration="{{ section.settings.animation_duration }}"
  data-animation-start="{{ section.settings.animation_start }}"
>
