<style>
  .cg-section {
    background-color: {{ section.settings.bg_color }};
    padding: 40px;
    font-family: 'Cormorant Garamond', serif;
  }

  .cg-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    gap: 215px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
  }

  .cg-header-content {
    flex: 0 0 50%;
  }

  .cg-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    color: {{ section.settings.heading_color }};
    font-family: 'Playfair Display', sans-serif;
    font-weight: 400;
    font-style: italic;
    margin: 0 0 22px 0;
    line-height: 121%;
    opacity: 0;
    animation: fadeInLeft 0.8s ease 0.2s forwards;
  }

  .cg-desc {
    font-size: {{ section.settings.desc_font_size }}px;
    color: {{ section.settings.desc_color }};
    font-family: 'Archivo', sans-serif;
    font-weight: 300;
    line-height: 151%;
    margin: 0;
    opacity: 0;
    animation: fadeInLeft 0.8s ease 0.4s forwards;
  }

  .cg-collections {
    display: flex;
    gap: 110px;
    align-items: flex-end;
    flex-wrap: wrap;
    position: relative;
    flex: 0 0 50%;
    justify-content: flex-start;
  }

  .cg-collection {
    font-size: {{ section.settings.collection_font_size }}px;
    color: {{ section.settings.collection_color }};
    font-family: 'Archivo', sans-serif;
    text-transform: uppercase;
    font-weight: 300;
    line-height: 24px;
    cursor: pointer;
    padding-bottom: 13px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease forwards;
  }

  .cg-collection:nth-child(1) { animation-delay: 0.3s; }
  .cg-collection:nth-child(2) { animation-delay: 0.4s; }
  .cg-collection:nth-child(3) { animation-delay: 0.5s; }

  .cg-collection::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    height: 1.5px;
    width: 132px;
    background: {{ section.settings.collection_color }};
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  .cg-collection.active::after {
    transform: translateX(-50%) scaleX(1);
    background: #F86E42;
  }

  .cg-collection.active {
    color: #F86E42;
    transform: translateY(-2px);
  }

  .cg-collection:hover {
    transform: translateY(-2px);
    opacity: 1;
  }

  .cg-collection:hover::after {
    transform: translateX(-50%) scaleX(1);
  }

  .cg-slider {
    position: relative;
  }

  .cg-products-wrap {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .cg-products-wrap[style*="block"] {
    animation: fadeIn 0.6s ease forwards;
  }

  .cg-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 37px;
    margin-bottom: 30px;
  }

  .cg-card {
    padding: 10px;
    background: #F2E4BD;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cg-card[style*="block"] {
    animation: cardFadeIn 0.6s ease forwards;
  }

  .cg-card:nth-child(1) { animation-delay: 0.1s; }
  .cg-card:nth-child(2) { animation-delay: 0.2s; }
  .cg-card:nth-child(3) { animation-delay: 0.3s; }
  .cg-card:nth-child(4) { animation-delay: 0.4s; }

  .cg-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }

  .cg-img-wrap {
    position: relative;
    overflow: hidden;
    margin-bottom: 15px;
    aspect-ratio: 3/4;
  }

  .cg-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }

  .cg-img-primary {
    position: relative;
    z-index: 2;
  }

  .cg-img-secondary {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    opacity: 0;
  }

  .cg-card:hover .cg-img-primary {
    opacity: 0;
    transform: scale(1.05);
  }

  .cg-card:hover .cg-img-secondary {
    opacity: 1;
    transform: scale(1.05);
  }

  .cg-wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 13px;
    font-family: 'Archivo', sans-serif;
    font-weight: 300;
    letter-spacing: 2%;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 2px;
    color: #F2E4BD;
    z-index: 3;
    opacity: 1;
    transition: all 0.3s ease;
  }

  .cg-card:hover .cg-wishlist {
    opacity: 0;
    transform: translateX(0);
    transform: translateX(10px);
  }

  .cg-info {
    color: #fff;
  }

  .cg-title-price {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 14px;
    gap: 10px;
  }

  .cg-title {
    font-size: 22px;
    font-weight: 400;
    line-height: 151%;
    font-family: 'Archivo', sans-serif;
    text-transform: uppercase;
    margin: 0;
    color: #494A2F;
    transition: color 0.3s ease;
  }

  .cg-price {
    font-size: 14px;
    font-weight: 400;
    line-height: 138%;
    font-family: 'Archivo', sans-serif;
    text-transform: uppercase;
    margin: 0;
    color: #494A2F;
    white-space: nowrap;
    transition: color 0.3s ease;
  }


  .cg-product-desc {
    font-size: 12px;
    font-weight: 300;
    line-height: 138%;
    font-family: 'Archivo', sans-serif;
    margin: 0;
    color: #494A2F;
    transition: opacity 0.3s ease;
  }

  .cg-card:hover .cg-product-desc {
    opacity: 0.8;
  }

  .cg-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .cg-dot {
    width: 40px;
    height: 3px;
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform: scaleX(0.8);
  }

  .cg-dot.active {
    background: #F86E42;
    transform: scaleX(1.2);
  }

  .cg-dot:hover {
    background: rgba(255, 255, 255, 0.5);
    transform: scaleX(1);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .cg-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .cg-section {
      padding: 20px;
    }

    .cg-header {
      flex-direction: column;
    }

    .cg-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .cg-heading {
      font-size: 32px;
    }
  }

  @media (max-width: 480px) {
    .cg-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="cg-section">
  <div class="cg-header">
    <div class="cg-header-content">
      <h2 class="cg-heading">{{ section.settings.heading }}</h2>
      <p class="cg-desc">{{ section.settings.description }}</p>
    </div>
    
    <div class="cg-collections">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          <div class="cg-collection" data-cg-index="{{ forloop.index0 }}">
            {{ block.settings.collection.title }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="cg-slider">
    {% for block in section.blocks %}
      {% if block.settings.collection != blank %}
        <div class="cg-products-wrap" data-cg-products="{{ forloop.index0 }}" style="{% if forloop.index0 != 0 %}display: none;{% endif %}">
          <div class="cg-grid">
            {% for product in block.settings.collection.products %}
              <div class="cg-card" data-cg-prod="{{ forloop.index0 }}" style="{% if forloop.index0 >= 4 %}display: none;{% endif %}">
                <div class="cg-img-wrap">
                  {% if product.images[0] %}
                    <img class="cg-img-primary" src="{{ product.images[0] | img_url: '600x' }}" alt="{{ product.title }}">
                  {% endif %}
                  
                  {% if product.images[1] %}
                    <img class="cg-img-secondary" src="{{ product.images[1] | img_url: '600x' }}" alt="{{ product.title }}">
                  {% elsif product.images[0] %}
                    <img class="cg-img-secondary" src="{{ product.images[0] | img_url: '600x' }}" alt="{{ product.title }}">
                  {% endif %}
                  
                  {% if block.settings.show_wishlist %}
                    <div class="cg-wishlist">WISHLIST</div>
                  {% endif %}
                </div>
                
                <div class="cg-info">
                  <div class="cg-title-price">
                    <h3 class="cg-title">{{ product.title }}</h3>
                    <span class="cg-price">{{ product.price | money }}</span>
                  </div>
                  
                  <p class="cg-product-desc">
                    {{ product.description | strip_html | truncate: 100 }}
                  </p>
                </div>
              </div>
            {% endfor %}
          </div>

          {% assign total_products = block.settings.collection.products.count %}
          {% assign total_pages = total_products | divided_by: 4.0 | ceil %}
          
          {% if total_pages > 1 %}
            <div class="cg-dots">
              {% for i in (1..total_pages) %}
                <div class="cg-dot {% if forloop.index == 1 %}active{% endif %}" data-cg-page="{{ forloop.index0 }}" data-cg-coll="{{ forloop.parentloop.index0 }}"></div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cgCollections = document.querySelectorAll('.cg-collection');
    const cgProductsWraps = document.querySelectorAll('.cg-products-wrap');
    
    // Collection switching
    cgCollections.forEach(coll => {
      coll.addEventListener('click', function() {
        const index = this.getAttribute('data-cg-index');
        
        cgCollections.forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        
        cgProductsWraps.forEach(pw => {
          pw.style.display = 'none';
        });
        
        const targetWrap = document.querySelector(`.cg-products-wrap[data-cg-products="${index}"]`);
        if (targetWrap) {
          targetWrap.style.display = 'block';
          showProductsForPage(targetWrap, 0);
        }
      });
    });

    // Set first collection as active
    if (cgCollections.length > 0) {
  cgCollections[0].classList.add('active');
  // ALSO show first products wrap and first page of products!
  if (cgProductsWraps.length > 0) {
    cgProductsWraps[0].style.display = 'block';
    showProductsForPage(cgProductsWraps[0], 0);
  }
}

    // Slider dots functionality
    const cgDots = document.querySelectorAll('.cg-dot');
    
    cgDots.forEach(dot => {
      dot.addEventListener('click', function() {
        const page = parseInt(this.getAttribute('data-cg-page'));
        const collIndex = this.getAttribute('data-cg-coll');
        const wrap = document.querySelector(`.cg-products-wrap[data-cg-products="${collIndex}"]`);
        
        if (!wrap) return;
        
        // Update active dot
        const siblingDots = wrap.querySelectorAll('.cg-dot');
        siblingDots.forEach(d => d.classList.remove('active'));
        this.classList.add('active');
        
        // Show products for this page
        showProductsForPage(wrap, page);
      });
    });

    function showProductsForPage(wrap, page) {
      const grid = wrap.querySelector('.cg-grid');
      const allCards = grid.querySelectorAll('.cg-card');
      const startIndex = page * 4;
      const endIndex = startIndex + 4;
      
      // Hide all products first
      allCards.forEach(card => {
        card.style.display = 'none';
      });
      
      // Show only products for current page with staggered animation
      allCards.forEach((card, index) => {
        if (index >= startIndex && index < endIndex) {
          setTimeout(() => {
            card.style.display = 'block';
          }, (index - startIndex) * 100);
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Collections Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#5a5c4a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objects of the House"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "At House of Thalpa, every creation begins with heritage and ends with meaning."
    },
    {
      "type": "range",
      "id": "desc_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 14
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "collection_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Collection Name Font Size",
      "default": 12
    },
    {
      "type": "color",
      "id": "collection_color",
      "label": "Collection Name Color",
      "default": "#d4a574"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 3,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "checkbox",
          "id": "show_wishlist",
          "label": "Show Wishlist Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Grid"
    }
  ]
}
{% endschema %}