<div 
  class="biking-hero-section"
  style="background-image:url({{ section.settings.background_image | img_url: 'master' }});"
>
  <div class="biking-hero-content">
    <div class="biking-hero-titles">
      <span 
        class="biking-hero-title-1"
        style="color: {{ section.settings.title_color_primary }}; font-size: {{ section.settings.title_size }}px;"
      >
        {{ section.settings.title_line1 }}
      </span>
      <br>
      <span 
        class="biking-hero-title-2" 
        style="color: {{ section.settings.title_color_secondary }}; font-size: {{ section.settings.title_size }}px;"
      >
        {{ section.settings.title_line2 }}
      </span>
      <br>
      <span 
        class="biking-hero-title-3" 
        style="color: {{ section.settings.title_color_secondary }}; font-size: {{ section.settings.title_size }}px;"
      >
        {{ section.settings.title_line3 }}
      </span>
    </div>
    <div 
      class="biking-hero-polygon"
      style="background: {{ section.settings.polygon_bg_color }};"
    >
      <div
        class="biking-hero-polygon-text"
        style="color: {{ section.settings.polygon_text_color }}; font-size: {{ section.settings.polygon_text_size }}px;"
      >
        {{ section.settings.polygon_text | newline_to_br }}
      </div>
    </div>
  </div>
</div>

<style>
.biking-hero-section {
  position: relative;
  background-size: cover;
  background-position: center;
  width: 100%;
  min-height: 398px;
  padding: 90px 75px;
  box-sizing: border-box;
  overflow: visible;
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  justify-content: center;
}

.biking-hero-content {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  z-index: 2;
}

/* Heading & Text Styling */
.biking-hero-titles {
  text-align: left;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 0;
  font-family: 'intro-cond-black', sans-serif;
  font-weight: 400;
  line-height: 0.9;
  letter-spacing: 1.5px;
  z-index: 3;
}

.biking-hero-title-1,
.biking-hero-title-2,
.biking-hero-title-3 {
  display: block;
  margin: 0;
  padding: 0;
}

/* Polygon Styling */
.biking-hero-polygon {
  position: absolute;
  right: 148px;
  bottom: -97.9%;
  width: 502px;
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  /* Hexagon shape */
 clip-path: polygon(10% 0, 90% 0%, 100% 50%, 90% 100%, 10% 100%, 0% 50%);


  z-index: 1;
  font-family: 'Termina', sans-serif;
  box-shadow: 0 6px 18px rgba(0,0,0,0.10);
  transition: right 0.3s cubic-bezier(.4,0,.2,1);
  box-sizing: border-box;
  font-weight: 700;
}

.biking-hero-polygon-text {
  text-align: center;
  font-family: 'intro-cond-black', sans-serif;
  font-weight: 400;
  text-transform: uppercase;
  width: 230px;
  line-height: 120%;
}

/* Responsiveness */
@media (max-width: 900px) {
  .biking-hero-section {
    padding: 60px 32px;
  }
  .biking-hero-polygon {
    right: 20px;
    width: calc(100% - 20px);
    height: 100px;
    min-width: 180px;
    font-size: 70%;
  }
}

@media (max-width: 768px) {
  .biking-hero-section {
    padding: 40px 16px;
    min-height: 176px;
  }
  .biking-hero-titles{
  line-height: 100% !important;
  margin-bottom: 25px;
  }
  .biking-hero-titles span {
    font-size: 28px !important;
  }
  .biking-hero-polygon {
    height: 65px;
    width: 204px;
    right: 14px;
  }
  .biking-hero-polygon-text {
    font-size: 18px !important;
    width: 100px;
  }
  .biking-hero-polygon {
    bottom: -72.5%;
  }
}
</style>

{% schema %}
{
  "name": "Isle of Man Section",
  "settings": [
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Main Title Settings"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Title Line 1 (Highlighted)",
      "default": "KICKSTART"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Title Line 2",
      "default": "YOUR AFFAIR"
    },
    {
      "type": "text",
      "id": "title_line3",
      "label": "Title Line 3",
      "default": "WITH BIKING"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 64
    },
    {
      "type": "color",
      "id": "title_color_primary",
      "label": "Title Color (Line 1 - Highlight)",
      "default": "#FFD700"
    },
    {
      "type": "color",
      "id": "title_color_secondary",
      "label": "Title Color (Lines 2 & 3)",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Polygon Overlay Settings"
    },
    {
      "type": "color",
      "id": "polygon_bg_color",
      "label": "Polygon Background Color",
      "default": "#7FA05A"
    },
    {
      "type": "textarea",
      "id": "polygon_text",
      "label": "Polygon Text",
      "default": "ISLE OF\nMAN"
    },
    {
      "type": "range",
      "id": "polygon_text_size",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Polygon Text Size",
      "default": 52
    },
    {
      "type": "color",
      "id": "polygon_text_color",
      "label": "Polygon Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Isle of Man Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
