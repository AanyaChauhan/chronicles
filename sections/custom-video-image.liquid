<div class="custom-media-section">
  <div class="media-section-media">
    {% if section.settings.media_type == "image" and section.settings.media_image %}
    <img class="media-full" src="{{ section.settings.media_image | image_url }}" alt="Section image" />
    {% elsif section.settings.media_type == "video" and section.settings.media_video %}
    <div class="media-full">{{ section.settings.media_video | media_tag }}</div>
    {% endif %}
    <h2 class="media-section-text">{{ section.settings.media_text }}</h2>
  </div>
</div>

<style>
.custom-media-section{
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.media-section-media {
  position: relative;
  width: 100%;
  min-height: 647px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}
.media-full img, .media-full video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.media-full {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.media-section-text {
  position: absolute;
  bottom: 0;
  width: 100%;
  padding: 0 100px 45px 100px; 
  text-align: center;
  color: #fff;
  font-size: 32px;
  font-weight: 500;
  box-sizing: border-box;
  z-index: 1;
}
</style>

{% schema %}
{
  "name": "Media with Text",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "media_image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "media_video",
      "label": "Video"
    },
    {
      "type": "inline_richtext",
      "id": "media_text",
      "label": "Text",
      "default": "FROM INDIA TO THE WORLD — CERTIFIED SILVER JEWELLERY, CRAFTED TO STAY TRUE."
    }
  ],
  "presets": [
    {
      "name": "Media with Text",
      "category": "Custom"
    }
  ]
}
{% endschema %}