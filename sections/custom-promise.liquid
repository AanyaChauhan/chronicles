<div class="custom-section-wrapper">
    <div class="custom-title">{{ section.settings.title }}</div>
  <div class="custom-image-text-block">
    {% if section.settings.section_image %}
      <div class="custom-image-block">
        <img src="{{ section.settings.section_image | image_url: width: 600 }}" alt="Section Image" class="custom-image">
      </div>
    {% endif %}
    <div class="custom-content-block">
      <div class="custom-subtitle">{{ section.settings.subtitle }}</div>
      <div class="custom-description">{{ section.settings.description }}</div>
    </div>
  </div>
</div>


{% style %}
.custom-section-wrapper {
  background-color: {{ section.settings.bg_color }};
  padding: 0 100px 60px 100px;
}

.custom-title {
    text-align: center;
    padding-top: 330px;
    margin-bottom: 90px;
    font-size: {{ section.settings.title_font_size }}px;
    color: {{ section.settings.title_color }};
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    line-height: 45px;
    font-weight: 400;
    line-height: 1.3;
    margin-left: auto;
    margin-right: auto;
    max-width: 594px;
  }
.custom-image-text-block {
  display: flex;
  align-items: center;
  gap: 80px;
  width: 100%;
  justify-content: flex-start;
}
.custom-image-block {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 653px;
  height: 471px;
  border-radius: 8px;
}
.custom-image{
  width: 100%;
  height: 100%;

}

.custom-content-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
}
.custom-content-block .custom-subtitle {
  font-size: {{ section.settings.subtitle_font_size }}px;
  color: {{ section.settings.subtitle_color }};
  font-family: 'Givonic', sans-serif;
  font-weight: 400px;
  margin-bottom: 60px;
}
.custom-content-block .custom-description {
  color: {{ section.settings.description_text_color }};
  font-size: {{ section.settings.font_size}}px;
  font-family: 'Montserrat', sans-serif;
  font-weight: 400;
  line-height: 28px;
}

@media (max-width: 900px) {
  .custom-section-wrapper {
    padding: 0 20px 40px 20px;
  }
  .custom-image-text-block {
    flex-direction: column;
    gap: 32px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Custom Promise",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f7f7e4"
    },
    {
      "type": "image_picker",
      "id": "section_image",
      "label": "Section Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Always True — To You, To The Earth, To What Matters Most."
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (px)",
      "default": 18,
      "min": 12,
      "max": 36,
      "step": 1
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#222222"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A THOUGHTFUL PROMISE"
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "label": "Subtitle Font Size (px)",
      "default": 18,
      "min": 12,
      "max": 36,
      "step": 1
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#222222"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We know that sustainability is a journey — not a finish line. That’s why we’re constantly learning, evolving, and making better choices across design, sourcing, packaging, and production.<br>Because to us, silver isn't just timeless. It’s a reflection of the values we choose to hold close — honesty, care, and responsibility."
    },
    {
      "type": "color",
      "id": "description_text_color",
      "label": "Text color",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (px)",
      "default": 18,
      "min": 12,
      "max": 36,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "Custom Promise"
    }
  ]
}
{% endschema %}
