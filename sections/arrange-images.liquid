        </div>
      {% elsif block.type == 'audio_card' %}
        <div class="custom-audio-card-{{ section.id }} {% if block.settings.animation_style != 'none' %}animation-ready{% endif %}"
             data-animation-style="{{ block.settings.animation_style }}"
             data-animate-on-scroll="{{ block.settings.animate_on_scroll }}"
             data-auto-animate="{{ block.settings.auto_animate }}"
             data-section-id="{{ section.id }}"
             data-block-id="{{ block.id }}"
             style="
               left: calc(50% + {{ block.settings.position_x_desktop }}px);
               top: calc(50% + {{ block.settings.position_y_desktop }}px);
               transform: translate(-50%, -50%) rotate({{ block.settings.rotation | default: 0 }}deg);
               width: {{ block.settings.card_width }}px;
               height: {{ block.settings.card_height }}px;
               z-index: {{ block.settings.z_index }};
