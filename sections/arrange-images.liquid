                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              
              {% comment %} Output the regular word if not colored {% endcomment %}
              {% if word_processed == false %}
                {{ word_with_punctuation }}
              {% endif %}
              
              {% comment %} Add space between words {% endcomment %}
              {% unless forloop.last %} {% endunless %}
            {% endfor %}
          {% else %}
            {{ title }}
          {% endif %}
        {% endif %}
      </h2>
    {% endif %}

    {% if section.settings.section_subtitle != blank %}
