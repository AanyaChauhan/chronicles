<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Get all cards for this specific section (both image and audio cards)
    const imageCards = document.querySelectorAll('.custom-card-image-{{ section.id }}');
    const audioCards = document.querySelectorAll('.custom-audio-card-{{ section.id }}');
    const allCards = [...imageCards, ...audioCards];
    
    // Process each card based on animation settings
    allCards.forEach(card => {
      const animationStyle = card.getAttribute('data-animation-style');
      const animateOnScroll = card.getAttribute('data-animate-on-scroll') === 'true';
      const autoAnimate = card.getAttribute('data-auto-animate') === 'true';
      const sectionId = card.getAttribute('data-section-id');
      
      // Initialize cards that should auto-animate on page load
      if (animationStyle !== 'none' && autoAnimate && !animateOnScroll) {
        // Short timeout to ensure styles are applied after page load
        setTimeout(() => {
          card.classList.add(`animated-${animationStyle}-${sectionId}`);
        }, 100);
      }
      
      // For continuous animations like bounce, pulse, etc. that should start visible
      if (['bounce', 'pulse', 'float', 'swing', 'heartbeat', 'moonwalk-dance', 'monkey-wiggle-waggle', 'auto-rotate'].includes(animationStyle)) {
        card.style.opacity = '1';
      }
    });
    
    // Set up scroll observer for scroll-triggered animations
    const observerOptions = {
      root: null, // viewport
      rootMargin: '0px',
      threshold: 0.1 // trigger when 10% of the element is visible
    };
    
    const observerCallback = (entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const card = entry.target;
          const animationStyle = card.getAttribute('data-animation-style');
          const animateOnScroll = card.getAttribute('data-animate-on-scroll') === 'true';
          const sectionId = card.getAttribute('data-section-id');
          
          if (animationStyle && animationStyle !== 'none' && animateOnScroll) {
            card.classList.add(`animated-${animationStyle}-${sectionId}`);
          }
          
          // Unobserve after animation is triggered
          observer.unobserve(card);
        }
      });
    };
    
    const observer = new IntersectionObserver(observerCallback, observerOptions);
    
    // Observe cards that should animate on scroll
    allCards.forEach(card => {
      const animateOnScroll = card.getAttribute('data-animate-on-scroll') === 'true';
      const animationStyle = card.getAttribute('data-animation-style');
      
      if (animateOnScroll && animationStyle !== 'none') {
        observer.observe(card);
      }
    });
  });

  // Audio functionality
  function toggleAudio(audioId, button) {
    const audio = document.getElementById(audioId);
    const playIcon = button.querySelector('.play-icon');
    const pauseIcon = button.querySelector('.pause-icon');
    
    if (audio.paused) {
      // Pause all other audio elements
      const allAudio = document.querySelectorAll('audio');
      allAudio.forEach(a => {
        if (a !== audio && !a.paused) {
          a.pause();
          // Reset other play buttons
          const otherButtons = document.querySelectorAll('.play-button-{{ section.id }}');
          otherButtons.forEach(b => {
            if (b !== button) {
              b.querySelector('.play-icon').style.display = 'block';
              b.querySelector('.pause-icon').style.display = 'none';
            }
          });
        }
      });
      
      audio.play();
      playIcon.style.display = 'none';
      pauseIcon.style.display = 'block';
    } else {
      audio.pause();
      playIcon.style.display = 'block';
      pauseIcon.style.display = 'none';
    }
  }

  function updateProgress(sectionId, blockId) {
    const audio = document.getElementById(`audio-${sectionId}-${blockId}`);
    const progressBar = document.getElementById(`progress-${sectionId}-${blockId}`);
    const timeDisplay = document.getElementById(`time-${sectionId}-${blockId}`);
    
    if (audio.duration) {
      const progress = (audio.currentTime / audio.duration) * 100;
      progressBar.style.width = progress + '%';
      
      const currentMinutes = Math.floor(audio.currentTime / 60);
      const currentSeconds = Math.floor(audio.currentTime % 60);
      const durationMinutes = Math.floor(audio.duration / 60);
      const durationSeconds = Math.floor(audio.duration % 60);
      
      timeDisplay.textContent = `${currentMinutes}:${currentSeconds.toString().padStart(2, '0')} / ${durationMinutes}:${durationSeconds.toString().padStart(2, '0')}`;
    }
  }

  function updateDuration(sectionId, blockId) {
    const audio = document.getElementById(`audio-${sectionId}-${blockId}`);
    const timeDisplay = document.getElementById(`time-${sectionId}-${blockId}`);
    
    if (audio.duration) {
      const durationMinutes = Math.floor(audio.duration / 60);
      const durationSeconds = Math.floor(audio.duration % 60);
      timeDisplay.textContent = `0:00 / ${durationMinutes}:${durationSeconds.toString().padStart(2, '0')}`;
    }
  }

  function seekAudio(event, audioId) {
    const audio = document.getElementById(audioId);
    const progressBar = event.currentTarget;
    const rect = progressBar.getBoundingClientRect();
    const percent = (event.clientX - rect.left) / rect.width;
    
    if (audio.duration) {
      audio.currentTime = percent * audio.duration;
    }
  }

  function resetAudio(sectionId, blockId) {
    const button = document.querySelector(`[onclick="toggleAudio('audio-${sectionId}-${blockId}', this)"]`);
    const playIcon = button.querySelector('.play-icon');
    const pauseIcon = button.querySelector('.pause-icon');
    
    playIcon.style.display = 'block';
    pauseIcon.style.display = 'none';
  }
</script>

