        {% if section.settings.enable_line_breaks %}
          {% assign title_parts = title | split: '||' %}
          {% for part in title_parts %}
            <span class="title-line-{{ section.id }}">
              {% comment %} Process word highlighting within each part {% endcomment %}
              {% if section.settings.enable_word_highlighting %}
                {% assign original_words = part | split: ' ' %}
                {% for word in original_words %}
                  {% assign word_with_punctuation = word | strip %}
                  {% assign word_clean = word_with_punctuation | downcase | replace: ',', '' | replace: '.', '' | replace: '!', '' | replace: '?', '' | replace: ':', '' | replace: ';', '' %}
                  {% assign word_processed = false %}
                  
                  {% comment %} Check against Color Group 1 {% endcomment %}
                  {% if section.settings.color_group_1_words != blank %}
                    {% assign color_words = section.settings.color_group_1_words | downcase | split: ',' %}
                    {% for color_word in color_words %}
                      {% assign trimmed_color_word = color_word | strip %}
                      {% if word_clean == trimmed_color_word %}
                        <span class="highlighted-word-{{ section.id }} color-group-1-{{ section.id }}">{{ word_with_punctuation }}</span>
                        {% assign word_processed = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  
                  {% comment %} Check against Color Group 2 {% endcomment %}
                  {% if word_processed == false and section.settings.color_group_2_words != blank %}
                    {% assign color_words = section.settings.color_group_2_words | downcase | split: ',' %}
                    {% for color_word in color_words %}
                      {% assign trimmed_color_word = color_word | strip %}
                      {% if word_clean == trimmed_color_word %}
                        <span class="highlighted-word-{{ section.id }} color-group-2-{{ section.id }}">{{ word_with_punctuation }}</span>
                        {% assign word_processed = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  
                  {% comment %} Check against Color Group 3 {% endcomment %}
                  {% if word_processed == false and section.settings.color_group_3_words != blank %}
                    {% assign color_words = section.settings.color_group_3_words | downcase | split: ',' %}
                    {% for color_word in color_words %}
                      {% assign trimmed_color_word = color_word | strip %}
                      {% if word_clean == trimmed_color_word %}
                        <span class="highlighted-word-{{ section.id }} color-group-3-{{ section.id }}">{{ word_with_punctuation }}</span>
                        {% assign word_processed = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  
                  {% comment %} Output the regular word if not colored {% endcomment %}
                  {% if word_processed == false %}
                    {{ word_with_punctuation }}
                  {% endif %}
                  
                  {% comment %} Add space between words {% endcomment %}
                  {% unless forloop.last %} {% endunless %}
                {% endfor %}
              {% else %}
                {{ part }}
              {% endif %}
            </span>
            {% unless forloop.last %}<br>{% endunless %}
          {% endfor %}
        {% else %}
          {% comment %} Process the title without line breaks {% endcomment %}
          {% if section.settings.enable_word_highlighting %}
            {% assign original_words = title | split: ' ' %}
            {% for word in original_words %}
              {% assign word_with_punctuation = word | strip %}
              {% assign word_clean = word_with_punctuation | downcase | replace: ',', '' | replace: '.', '' | replace: '!', '' | replace: '?', '' | replace: ':', '' | replace: ';', '' %}
              {% assign word_processed = false %}
              
              {% comment %} Check against Color Group 1 {% endcomment %}
              {% if section.settings.color_group_1_words != blank %}
                {% assign color_words = section.settings.color_group_1_words | downcase | split: ',' %}
                {% for color_word in color_words %}
                  {% assign trimmed_color_word = color_word | strip %}
                  {% if word_clean == trimmed_color_word %}
