<style>
.custom-section-image-{{ section.id }} {
  position: relative;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
  height: 640px;
  min-height: 600px;
}

.section-heading-image-{{ section.id }} {
  position: absolute;
  text-align: left;
  color: {{ section.settings.title_color }};
  z-index: 2;
  width: {{ section.settings.title_width }}px;
  max-width: 90%;
}

/* Heading positioning classes */
.section-heading-image-{{ section.id }}.position-top-left {
  top: 50px;
  left: 50px;
  text-align: left;
  transform: none;
}

.section-heading-image-{{ section.id }}.position-top-center {
  top: 50px;
  left: 50%;
  text-align: center;
  transform: translateX(-50%);
}

.section-heading-image-{{ section.id }}.position-top-right {
  top: 50px;
  right: 50px;
  text-align: left;
  transform: none;
}

.section-heading-image-{{ section.id }}.position-center-left {
  top: 50%;
  left: 50px;
  text-align: left;
  transform: translateY(-50%);
}

.section-heading-image-{{ section.id }}.position-center-center {
  top: 50%;
  left: 50%;
  text-align: center;
  transform: translate(-50%, -50%);
}

.section-heading-image-{{ section.id }}.position-center-right {
  top: 50%;
  right: 50px;
  text-align: left;
  transform: translateY(-30%);
}

.section-heading-image-{{ section.id }}.position-bottom-left {
  bottom: 50px;
  left: 50px;
  text-align: left;
  transform: none;
}

.section-heading-image-{{ section.id }}.position-bottom-center {
  bottom: 50px;
  left: 50%;
  text-align: center;
  transform: translateX(-50%);
}

.section-heading-image-{{ section.id }}.position-bottom-right {
  bottom: 50px;
  right: 50px;
  text-align: right;
  transform: none;
}

.section-heading-image-{{ section.id }} h2 {
  font-size: {{ section.settings.title_size }}px;
  margin: 0 0 10px 0;
  font-weight: 400;
  line-height: 1.2;
}

.section-heading-image-{{ section.id }} p {
  font-size: {{ section.settings.subtitle_size }}px;
  margin: 0;
  width: 100%;
  color: {{ section.settings.subtitle_color }};
  line-height: 1.4;
}

.cards-wrapper-image-{{ section.id }} {
  position: relative;
  width: 100%;
  height: 100%;
}

.custom-card-image-{{ section.id }} {
  position: absolute;
  text-align: center;
  color: #ffffff;
  font-weight: bold;
  transform-origin: center center;
  will-change: transform;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.custom-card-image-{{ section.id }}[data-has-hover-text="true"] {
  cursor: pointer;
}

.custom-card-image-wrapper-{{ section.id }} {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  transform-origin: center center;
}

/* Audio Card Styles */
.custom-audio-card-{{ section.id }} {
  position: absolute;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  overflow: hidden;
  transform-origin: center center;
  will-change: transform;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.audio-content-{{ section.id }} {
  position: relative;
  padding: 20px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
 
}

.audio-controls-{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}

.play-button-{{ section.id }} {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.play-button-{{ section.id }}:hover {
  background: rgba(255, 255, 255, 1);
  transform: scale(1.1);
}

.play-button-{{ section.id }} svg {
  width: 20px;
  height: 20px;
  fill: #000;
}

.audio-title-{{ section.id }} {
  flex: 1;
  text-align: left;
  margin: 0;

  letter-spacing: 2px;
}

.audio-progress-wrapper-{{ section.id }} {
  margin-bottom: 15px;
}

.audio-progress-{{ section.id }} {
  width: 100%;
  height: 4px;
  background: rgba(255, 255, 255, 0.3);
  overflow: hidden;
  cursor: pointer;
}

.audio-progress-bar-{{ section.id }} {
  height: 100%;
  background: white;
  width: 0%;
  transition: width 0.1s ease;
}

.audio-subtitle-{{ section.id }} {
  margin: 0;
  opacity: 0.9;
  line-height: 1.4;
}

.audio-time-{{ section.id }} {
  position: absolute;
  bottom: 20px;
  right: 20px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
  display: none;
}

/* Hover rotation for each block */
{% for block in section.blocks %}
  {% if block.type == 'card' %}
    .custom-card-image-{{ section.id }}[data-block-id="{{ block.id }}"]:hover .custom-card-image-wrapper-{{ section.id }} {
      transform: rotate({{ block.settings.rotation | default: 0 | plus: block.settings.hover_rotation | default: 0 }}deg);
    }

    .custom-card-image-{{ section.id }}[data-block-id="{{ block.id }}"]:hover {
      transform: translate(-50%, -50%) rotate({{ block.settings.rotation | default: 0 | plus: block.settings.hover_rotation | default: 0 }}deg);
    }
  {% elsif block.type == 'audio_card' %}
    .custom-audio-card-{{ section.id }}[data-block-id="{{ block.id }}"]:hover {
      transform: translate(-50%, -50%) rotate({{ block.settings.rotation | default: 0 | plus: block.settings.hover_rotation | default: 0 }}deg) scale(1.05);
    }
  {% endif %}
{% endfor %}

.custom-card-image-{{ section.id }}.animated-auto-rotate-{{ section.id }} {
  opacity: 1;
  transform: translate(-50%, -50%) rotate(var(--card-rotation, 0deg)) !important;
}

.custom-card-image-{{ section.id }}.animated-auto-rotate-{{ section.id }} img {
  animation: auto-rotate-{{ section.id }} var(--animation-duration) linear var(--animation-delay) infinite;
  transform-origin: center center;
}

.custom-card-image-{{ section.id }}.animated-auto-rotate-{{ section.id }} .custom-card-image-text-{{ section.id }},
.custom-card-image-{{ section.id }}.animated-auto-rotate-{{ section.id }} .custom-card-image-hover-text-{{ section.id }} {
  transform: translate(-50%, -50%);
}

.custom-card-image-{{ section.id }} img {
  width: {{ block.settings.image_width | default: 100 }}%;
  max-width: 100%;
  border-radius: 0;
  display: block;
  margin: 0 auto;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Image hover rotation */
{% for block in section.blocks %}
  {% if block.type == 'card' %}
    .custom-card-image-{{ section.id }}[data-block-id="{{ block.id }}"]:hover img {
      transform: rotate({{ block.settings.hover_rotation | default: 0 }}deg);
    }
  {% endif %}
{% endfor %}

.custom-card-image-text-{{ section.id }} {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: {{ section.settings.overlay_text_size }}px;
  pointer-events: none;
  width: 90%;
  transition: opacity 0.3s ease;
}

.custom-card-image-{{ section.id }}[data-has-hover-text="true"]:hover .custom-card-image-text-{{ section.id }} {
  opacity: 0;
}

.custom-card-image-hover-text-{{ section.id }} {
  position: absolute;
  top: 50%;
  left: 50%;
  font-weight: 400;
  transform: translate(-50%, -50%);
  font-size: {{ section.settings.overlay_text_size }}px;
  pointer-events: none;
  width: 90%;
  opacity: 0;
  transition: opacity 0.3s ease;
}

{% for block in section.blocks %}
  {% if block.type == 'card' %}
    .custom-card-image-{{ section.id }}[data-block-id="{{ block.id }}"] .custom-card-image-hover-text-{{ section.id }} {
      color: {{ block.settings.hover_text_color | default: '#ffffff' }};
    }

    .custom-card-image-{{ section.id }}[data-block-id="{{ block.id }}"]:hover .custom-card-image-hover-text-{{ section.id }} {
      opacity: 1;
    }
  {% endif %}
{% endfor %}

/* Button Styles */
.custom-card-button-{{ section.id }} {
  position: absolute;
  display: inline-block;
  padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
  background-color: {{ section.settings.button_bg_color }};
  color: {{ section.settings.button_color }};
  font-size: {{ section.settings.button_font_size_desktop }}px;
  border-radius: {{ section.settings.button_border_radius }}px;
  text-decoration: none;
  transition: all 0.3s ease;
  z-index: 3;
  border: none;
  cursor: pointer;
  font-weight: 400;
}

.custom-card-button-{{ section.id }}:hover {
  background-color: {{ section.settings.button_hover_bg_color }};
  color: {{ section.settings.button_hover_color }};
  transform: translateY(-2px);
}

.custom-card-button-{{ section.id }}.button-top-left {
  top: 10px;
  left: 10px;
}

.custom-card-button-{{ section.id }}.button-top-center {
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
}

.custom-card-button-{{ section.id }}.button-top-right {
  top: 10px;
  right: 10px;
}

.custom-card-button-{{ section.id }}.button-middle-left {
  top: 50%;
  left: 10px;
  transform: translateY(-50%);
}

.custom-card-button-{{ section.id }}.button-middle-center {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.custom-card-button-{{ section.id }}.button-middle-right {
  top: 50%;
  right: 10px;
  transform: translateY(-50%);
}

.custom-card-button-{{ section.id }}.button-bottom-left {
  bottom: 10px;
  left: 10px;
}

.custom-card-button-{{ section.id }}.button-bottom-center {
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%);
}

.custom-card-button-{{ section.id }}.button-bottom-right {
  bottom: 10px;
  right: 10px;
}

/* Word highlighting styles */
.title-{{ section.id }} .color-group-1-{{ section.id }} {
  color: {{ section.settings.color_group_1 }};
}

.title-{{ section.id }} .color-group-2-{{ section.id }} {
  color: {{ section.settings.color_group_2 }};
}

.title-{{ section.id }} .color-group-3-{{ section.id }} {
  color: {{ section.settings.color_group_3 }};
}

.title-{{ section.id }} .title-line-{{ section.id }} {
  display: inline-block;
}

/* Animation ready state */
.custom-card-image-{{ section.id }}.animation-ready,
.custom-audio-card-{{ section.id }}.animation-ready {
  opacity: 0;
}

/* Animation Keyframes */
@keyframes fade-in-{{ section.id }} {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slide-up-{{ section.id }} {
  from { 
    transform: translate(-50%, -50%) translateY(100px) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  to { 
    transform: translate(-50%, -50%) translateY(0) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes slide-down-{{ section.id }} {
  from { 
    transform: translate(-50%, -50%) translateY(-100px) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  to { 
    transform: translate(-50%, -50%) translateY(0) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes slide-left-{{ section.id }} {
  from { 
    transform: translate(-50%, -50%) translateX(100px) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  to { 
    transform: translate(-50%, -50%) translateX(0) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes slide-right-{{ section.id }} {
  from { 
    transform: translate(-50%, -50%) translateX(-100px) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  to { 
    transform: translate(-50%, -50%) translateX(0) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes zoom-in-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) scale(0.2) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  100% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes zoom-out-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) scale(2) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  100% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes flip-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) perspective(400px) rotateY(90deg) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  100% { 
    transform: translate(-50%, -50%) perspective(400px) rotateY(0deg) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes flip-x-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) perspective(400px) rotateX(90deg) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  100% { 
    transform: translate(-50%, -50%) perspective(400px) rotateX(0deg) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes bounce-{{ section.id }} {
  0%, 20%, 50%, 80%, 100% { 
    transform: translate(-50%, -50%) translateY(0) rotate(var(--card-rotation, 0deg)); 
  }
  40% { 
    transform: translate(-50%, -50%) translateY(-40px) rotate(var(--card-rotation, 0deg)); 
  }
  60% { 
    transform: translate(-50%, -50%) translateY(-20px) rotate(var(--card-rotation, 0deg)); 
  }
}

@keyframes pulse-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
  }
  50% { 
    transform: translate(-50%, -50%) scale(1.1) rotate(var(--card-rotation, 0deg)); 
  }
  100% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
  }
}

@keyframes shake-{{ section.id }} {
  0%, 100% { 
    transform: translate(-50%, -50%) translateX(0) rotate(var(--card-rotation, 0deg)); 
  }
  10%, 30%, 50%, 70%, 90% { 
    transform: translate(-50%, -50%) translateX(-15px) rotate(var(--card-rotation, 0deg)); 
  }
  20%, 40%, 60%, 80% { 
    transform: translate(-50%, -50%) translateX(15px) rotate(var(--card-rotation, 0deg)); 
  }
}

@keyframes float-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) translateY(0) rotate(var(--card-rotation, 0deg)); 
  }
  50% { 
    transform: translate(-50%, -50%) translateY(-20px) rotate(var(--card-rotation, 0deg)); 
  }
  100% { 
    transform: translate(-50%, -50%) translateY(0) rotate(var(--card-rotation, 0deg)); 
  }
}

@keyframes swing-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) rotate(calc(var(--card-rotation, 0deg) - 10deg)); 
  }
  50% { 
    transform: translate(-50%, -50%) rotate(calc(var(--card-rotation, 0deg) + 10deg)); 
  }
  100% { 
    transform: translate(-50%, -50%) rotate(calc(var(--card-rotation, 0deg) - 10deg)); 
  }
}

@keyframes rotate-in-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) rotate(calc(var(--card-rotation, 0deg) - 90deg)); 
    opacity: 0; 
  }
  100% { 
    transform: translate(-50%, -50%) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes drop-in-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) translateY(-300px) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  70% { 
    transform: translate(-50%, -50%) translateY(20px) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
  85% { 
    transform: translate(-50%, -50%) translateY(-10px) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
  100% { 
    transform: translate(-50%, -50%) translateY(0) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes expansion-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) scale(0) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  60% { 
    transform: translate(-50%, -50%) scale(1.2) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
  100% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes slide-right-swing-{{ section.id }} {
  0% {
    transform: translate(-50%, -50%) translateX(-100px) rotate(calc(var(--card-rotation, 0deg) - 15deg));
    opacity: 0;
  }
  60% {
    transform: translate(-50%, -50%) translateX(0) rotate(calc(var(--card-rotation, 0deg) + 10deg));
    opacity: 1;
  }
  80% {
    transform: translate(-50%, -50%) translateX(0) rotate(calc(var(--card-rotation, 0deg) - 5deg));
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) translateX(0) rotate(var(--card-rotation, 0deg));
    opacity: 1;
  }
}

@keyframes slide-left-swing-{{ section.id }} {
  0% {
    transform: translate(-50%, -50%) translateX(100px) rotate(calc(var(--card-rotation, 0deg) + 15deg));
    opacity: 0;
  }
  60% {
    transform: translate(-50%, -50%) translateX(0) rotate(calc(var(--card-rotation, 0deg) - 10deg));
    opacity: 1;
  }
  80% {
    transform: translate(-50%, -50%) translateX(0) rotate(calc(var(--card-rotation, 0deg) + 5deg));
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) translateX(0) rotate(var(--card-rotation, 0deg));
    opacity: 1;
  }
}

@keyframes heartbeat-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
  }
  14% { 
    transform: translate(-50%, -50%) scale(1.15) rotate(var(--card-rotation, 0deg)); 
  }
  28% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
  }
  42% { 
    transform: translate(-50%, -50%) scale(1.15) rotate(var(--card-rotation, 0deg)); 
  }
  70% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
  }
  100% { 
    transform: translate(-50%, -50%) scale(1) rotate(var(--card-rotation, 0deg)); 
  }
}

@keyframes jelly-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) scale(1, 1) rotate(var(--card-rotation, 0deg)); 
    opacity: 0; 
  }
  30% { 
    transform: translate(-50%, -50%) scale(1.25, 0.75) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
  40% { 
    transform: translate(-50%, -50%) scale(0.75, 1.25) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
  50% { 
    transform: translate(-50%, -50%) scale(1.15, 0.85) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
  65% { 
    transform: translate(-50%, -50%) scale(0.95, 1.05) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
  75% { 
    transform: translate(-50%, -50%) scale(1.05, 0.95) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
  100% { 
    transform: translate(-50%, -50%) scale(1, 1) rotate(var(--card-rotation, 0deg)); 
    opacity: 1; 
  }
}

@keyframes moonwalk-dance-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) translateX(0) translateY(0) rotate(var(--card-rotation, 0deg)); 
  }
  25% { 
    transform: translate(-50%, -50%) translateX(-30px) translateY(-5px) rotate(calc(var(--card-rotation, 0deg) - 5deg)); 
  }
  50% { 
    transform: translate(-50%, -50%) translateX(-60px) translateY(0) rotate(calc(var(--card-rotation, 0deg) - 10deg)); 
  }
  75% { 
    transform: translate(-50%, -50%) translateX(-30px) translateY(5px) rotate(calc(var(--card-rotation, 0deg) - 5deg)); 
  }
  100% { 
    transform: translate(-50%, -50%) translateX(0) translateY(0) rotate(var(--card-rotation, 0deg)); 
  }
}

@keyframes monkey-wiggle-waggle-{{ section.id }} {
  0% { 
    transform: translate(-50%, -50%) translateX(0) translateY(0) skewX(0deg) rotate(var(--card-rotation, 0deg)); 
  }
  20% { 
    transform: translate(-50%, -50%) translateX(-15px) translateY(-8px) skewX(-10deg) rotate(calc(var(--card-rotation, 0deg) - 8deg)); 
  }
  40% { 
    transform: translate(-50%, -50%) translateX(15px) translateY(8px) skewX(10deg) rotate(calc(var(--card-rotation, 0deg) + 8deg)); 
  }
  60% { 
    transform: translate(-50%, -50%) translateX(-12px) translateY(-5px) skewX(-8deg) rotate(calc(var(--card-rotation, 0deg) - 5deg)); 
  }
  80% { 
    transform: translate(-50%, -50%) translateX(12px) translateY(5px) skewX(8deg) rotate(calc(var(--card-rotation, 0deg) + 5deg)); 
  }
  100% { 
    transform: translate(-50%, -50%) translateX(0) translateY(0) skewX(0deg) rotate(var(--card-rotation, 0deg)); 
  }
}

@keyframes auto-rotate-{{ section.id }} {
  0% { 
    transform: rotate(0deg); 
  }
  100% { 
    transform: rotate(360deg); 
  }
}

/* Animation classes for both image and audio cards */
.custom-card-image-{{ section.id }}.animated-fade-in-{{ section.id }},
.custom-audio-card-{{ section.id }}.animated-fade-in-{{ section.id }} {
  animation: fade-in-{{ section.id }} var(--animation-duration) ease-out var(--animation-delay) forwards;
}

.custom-card-image-{{ section.id }}.animated-slide-up-{{ section.id }},
.custom-audio-card-{{ section.id }}.animated-slide-up-{{ section.id }} {
  animation: slide-up-{{ section.id }} var(--animation-duration) ease-out var(--animation-delay) forwards;
}

.custom-card-image-{{ section.id }}.animated-slide-down-{{ section.id }},
.custom-audio-card-{{ section.id }}.animated-slide-down-{{ section.id }} {
  animation: slide-down-{{ section.id }} var(--animation-duration) ease-out var(--animation-delay) forwards;
}

.custom-card-image-{{ section.id }}.animated-slide-left-{{ section.id }},
.custom-audio-card-{{ section.id }}.animated-slide-left-{{ section.id }} {
  animation: slide-left-{{ section.id }} var(--animation-duration) ease-out var(--animation-delay) forwards;
}

