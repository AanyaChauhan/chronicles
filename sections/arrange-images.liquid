        color: {{ section.settings.button_color }};
        font-size: {{ section.settings.button_font_size_desktop }}px;
        padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
        border-radius: {{ section.settings.button_border_radius }}px;
      "
      onmouseover="this.style.backgroundColor='{{ section.settings.button_hover_bg_color }}'; this.style.color='{{ section.settings.button_hover_color }}'"
      onmouseout="this.style.backgroundColor='{{ section.settings.button_bg_color }}'; this.style.color='{{ section.settings.button_color }}'"
