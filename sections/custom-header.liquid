<!-- Custom Mega Menu Header -->
<style>
  body {
  padding-top: 78.5px; /* Adjust this value to match your header height */
}
 .cmh-header {
 background: {{ section.settings.header_bg_color }};
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  width: 100%;
}

  .cmh-header-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 40px;
  }

  .cmh-nav-left {
    display: flex;
    align-items: center;
    gap: 29px;
  }

  .cmh-nav-left a {
    font-size: 16px;
    font-family: 'Archivo', sans-serif;
    font-weight: 400;
    line-height: auto;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .cmh-nav-left a:hover {
    opacity: 0.7;
  }

  .cmh-nav-item {
    position: static;
  }

  .cmh-nav-item > a {
    display: flex;
    align-items: center;
    gap: 4px;
    position: relative;
  }

  .cmh-nav-item svg,
  .cmh-nav-item img.cmh-dropdown-icon {
    width: 13.73px;
    height: 6.87px;
  }

  .cmh-nav-item.cmh-active > a {
    font-weight: 600;
    text-decoration: underline;
     text-underline-offset: 4px;
  }

  

  .cmh-logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .cmh-logo img {
    height: {{ section.settings.logo_height }}px;
    width: 343.72px;
  }

  .cmh-nav-right {
    display: flex;
    align-items: center;
    gap: 44.83px;
  }

  .cmh-nav-right a:last-of-type {
    margin-right: -9.55px;
  }

  .cmh-nav-right a {
    font-size: 16px;
    font-family: 'Archivo', sans-serif;
    font-weight: 400;
    line-height: auto;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .cmh-nav-right a:hover {
    opacity: 0.7;
  }

  .cmh-hamburger-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    padding: 5px;
  }

  .cmh-hamburger-icon span {
    width: 18.75px;
    height: 1.5px;
    background: {{ section.settings.text_color }};
    transition: all 0.3s;
  }

  /* Mega Menu Dropdown - Full Width Below Header */
  .cmh-mega-menu-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: {{ section.settings.header_bg_color }};
    opacity: 0;
    visibility: hidden;
    transform: translateY(-20px);
    transition: all 0.4s ease;
    z-index: 98;
  }

  .cmh-nav-item.cmh-active .cmh-mega-menu-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .cmh-mega-menu-content {
    display: flex;
    padding: 55px 40px;
    gap: 50px;
  }

  .cmh-mega-menu-text-columns {
    display: flex;
    gap: 58px;
    flex: 1;
  }

  .cmh-mega-menu-column {
    flex: 1;
  }

  .cmh-mega-menu-column h3 {
    font-size: 14px;
    font-family: 'Archivo', sans-serif;
    font-weight: 300;
    line-height: 24px;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin-bottom: 16.76px;
  }

  .cmh-mega-menu-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cmh-mega-menu-column ul li {
    margin-bottom: 12px;
    padding: 0;
  }

  .cmh-mega-menu-column h3,
  .cmh-mega-menu-column a {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  
.cmh-mega-menu-column ul li a {
    font-size: 14px;
    font-family: 'Archivo', sans-serif;
    font-weight: 500;
    line-height: 151%;
    color: {{ section.settings.link_color }};
    text-decoration: none;
    text-transform: capitalize;
    transition: opacity 0.2s ease;
    cursor: pointer;
  }

  .cmh-mega-menu-column ul li a:hover {
    opacity: 0.7;
  }

  .cmh-mega-menu-images {
    display: flex;
    gap: 20px;
    flex: 1.2;
  }

  .cmh-mega-menu-image-item {
    flex: 1;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .cmh-mega-menu-image-item:hover {
    transform: translateY(-5px);
  }

  .cmh-mega-menu-image-item img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    margin-bottom: 15.48px;
    transition: opacity 0.3s ease;
    display: block;
  }

  .cmh-mega-menu-image-item:hover img {
    opacity: 0.85;
  }

  .cmh-mega-menu-image-item span {
    display: block;
    font-size: 14px;
    font-family: 'Archivo', sans-serif;
    font-weight: 300;
    line-height: 24px;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    text-align: left;
    white-space: normal;
    overflow: visible;
    transition: opacity 0.2s ease;
  }

  .cmh-mega-menu-image-item:hover span {
    opacity: 0.7;
  }

  /* Mega Menu Overlay - Blur Effect */
  .cmh-mega-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease;
    z-index: 97;
    pointer-events: none;
  }

  .cmh-mega-menu-overlay.cmh-show,
  .cmh-nav-item.cmh-active ~ .cmh-mega-menu-overlay {
    opacity: 1;
    visibility: visible;
  }

  /* Drawer Menu Styles */
  .cmh-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 999;
  }

  .cmh-drawer-overlay.cmh-active {
    opacity: 1;
    visibility: visible;
  }

  .cmh-drawer-menu {
    position: fixed;
    top: 0;
    right: -400px;
    width: 400px;
    height: 100vh;
    background: {{ section.settings.header_bg_color }};
    z-index: 1000;
    transition: right 0.4s ease;
    overflow-y: auto;
  }

  .cmh-drawer-menu.cmh-active {
    right: 0;
  }

  .cmh-drawer-header {
    padding: 25px 35px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cmh-drawer-search {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cmh-drawer-search-form {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cmh-drawer-search input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 14px;
    font-family: 'Archivo', sans-serif;
    line-height: 14px;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    outline: none;
  }

  .cmh-drawer-search input::placeholder {
    color: rgba(51, 51, 51, 0.5);
  }

  .cmh-drawer-search input[type="search"]::-webkit-search-cancel-button {
    display: none;
    -webkit-appearance: none;
  }

  .cmh-drawer-search-icon {
    cursor: pointer;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cmh-drawer-search-icon img {
    width: 14.5px;
    height: 14.5px;
    object-fit: contain;
  }

  .cmh-drawer-search-icon svg {
    width: 100%;
    height: 100%;
  }

  .cmh-drawer-close {
    cursor: pointer;
    font-size: 17px;
    color: {{ section.settings.text_color }};
    line-height: 1;
    padding: 0 5px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cmh-drawer-close img,
  .cmh-drawer-close svg {
    width: 16px;
    height: 16px;
  }

  .cmh-drawer-content {
    padding: 40px 30px;
    padding-bottom: 150px;
  }

  .cmh-drawer-menu-item {
    margin-bottom: 20px;
  }

  .cmh-drawer-menu-item a {
    font-size: 16px;
    font-family: 'Archivo', sans-serif;
    font-weight: 300;
    line-height: 24px;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    display: block;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .cmh-drawer-menu-item a:hover {
    opacity: 0.7;
  }

  .cmh-drawer-footer {
    padding: 0;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: {{ section.settings.header_bg_color }};
    padding-bottom: 6px;
  }

  .cmh-drawer-footer-item {
    margin-bottom: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.25) !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
  }
  .cmh-drawer-footer-item:last-child {
    margin-bottom: 0;
    border-top: none !important;
  }

  .cmh-drawer-footer-item a {
    display: block;
    text-align: center;
    font-size: 14px;
    font-family: 'Archivo', sans-serif;
    line-height: 24px;
    font-weight: 300;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    text-decoration: none;
    padding: 18px 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .cmh-drawer-footer-item a:hover {
    opacity: 0.7;
  }

  .cmh-drawer-footer-logo {
    text-align: center;
    padding: 20px 0;
    margin-bottom: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
  }


  .cmh-drawer-footer-logo img {
    width: 52.81px;
    height: 67.75px;
    object-fit: contain;
  }

  /* Blur effect when menu is open */
  body.cmh-menu-open .cmh-header,
  body.cmh-menu-open main,
  body.cmh-menu-open footer {
    filter: blur(0);
    transition: filter 0.3s ease;
  }

  

</style>

<header class="cmh-header">
  <div class="cmh-header-wrapper">
    <!-- Left Navigation -->
    <nav class="cmh-nav-left">
      {% if section.settings.about_link != blank %}
        <a href="{{ section.settings.about_link }}">ABOUT</a>
      {% endif %}
      
      <div class="cmh-nav-item" id="cmh-shop-nav-item">
        <a href="{{ section.settings.shop_link }}">
          SHOP
          {% if section.settings.dropdown_icon != blank %}
            {{ section.settings.dropdown_icon | image_url: width: 24 | image_tag: class: 'cmh-dropdown-icon', alt: 'dropdown' }}
          {% else %}
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 4.5L6 7.5L9 4.5"/>
            </svg>
          {% endif %}
        </a>
        
        <!-- Mega Menu Dropdown - Full Width -->
        <div class="cmh-mega-menu-dropdown">
          <div class="cmh-mega-menu-content">
            <!-- Text Columns Container -->
            <div class="cmh-mega-menu-text-columns">
              {% for block in section.blocks %}
                {% if block.type == 'menu_column' %}
                  <div class="cmh-mega-menu-column">
                    {% if block.settings.menu_handle != blank %}
                      {% assign menu = linklists[block.settings.menu_handle] %}
                      {% if menu.title != blank %}
                        <h3>{{ menu.title }}</h3>
                      {% elsif block.settings.alt_column_title != blank %}
                        <h3>{{ block.settings.alt_column_title }}</h3>
                      {% else %}
                        <h3>MENU</h3>
                      {% endif %}
                    {% elsif block.settings.alt_column_title != blank %}
                      <h3>{{ block.settings.alt_column_title }}</h3>
                    {% else %}
                      <h3>MENU</h3>
                    {% endif %}
                    <ul>
                      {% if block.settings.menu_handle != blank %}
                        {% assign menu = linklists[block.settings.menu_handle] %}
                        {% for link in menu.links %}
                          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                        {% endfor %}
                      {% endif %}
                    </ul>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <!-- Image Section -->
            <div class="cmh-mega-menu-images">
              {% for block in section.blocks %}
                {% if block.type == 'image_item' %}
                  <a href="{{ block.settings.link }}" class="cmh-mega-menu-image-item">
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                    <span>{{ block.settings.title }}</span>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Center Logo -->
    <div class="cmh-logo">
      <a href="/">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}
        {% else %}
          <span style="font-size: 18px; letter-spacing: 2px; text-transform: uppercase;">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- Right Navigation -->
    <nav class="cmh-nav-right">
      {% if section.settings.wishlist_link != blank %}
        <a href="{{ section.settings.wishlist_link }}">WISHLIST</a>
      {% endif %}
      <a href="/cart" id="cmh-cart-link">CART (<span id="cmh-cart-count">{{ cart.item_count }}</span>)</a>
      
      <!-- Hamburger Menu Icon -->
      <div class="cmh-hamburger-icon" id="cmh-hamburger-toggle">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </div>
</header>

<!-- Mega Menu Overlay -->
<div class="cmh-mega-menu-overlay" id="cmh-mega-menu-overlay"></div>

<!-- Drawer Overlay -->
<div class="cmh-drawer-overlay" id="cmh-drawer-overlay"></div>

<!-- Drawer Menu -->
<div class="cmh-drawer-menu" id="cmh-drawer-menu">
  <div class="cmh-drawer-header">
    <div class="cmh-drawer-search">
      <form action="/search" method="get" class="cmh-drawer-search-form">
        <div class="cmh-drawer-search-icon" onclick="this.closest('form').submit()">
          {% if section.settings.search_icon != blank %}
            {{ section.settings.search_icon | image_url: width: 32 | image_tag: alt: 'Search' }}
          {% else %}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="6" cy="6" r="5"/>
              <path d="M10 10L14 14"/>
            </svg>
          {% endif %}
        </div>
        <input type="search" name="q" placeholder="SEARCH" autocomplete="off">
      </form>
    </div>
    <div class="cmh-drawer-close" id="cmh-drawer-close">
      {% if section.settings.close_icon != blank %}
        {{ section.settings.close_icon | image_url: width: 32 | image_tag: alt: 'Close' }}
      {% else %}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 2L14 14M14 2L2 14"/>
        </svg>
      {% endif %}
    </div>
  </div>
  
  <div class="cmh-drawer-content">
    {% if section.settings.drawer_menu_handle != blank %}
      {% assign drawer_menu = linklists[section.settings.drawer_menu_handle] %}
      {% for link in drawer_menu.links %}
        <div class="cmh-drawer-menu-item">
          <a href="{{ link.url }}">{{ link.title }}</a>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  
  <div class="cmh-drawer-footer">
    {% if section.settings.drawer_logo != blank %}
      <div class="cmh-drawer-footer-logo">
        <div class="cmh-drawer-footer-logo-circle">
          {{ section.settings.drawer_logo | image_url: width: 100 | image_tag: alt: shop.name }}
        </div>
      </div>
    {% elsif section.settings.logo != blank %}
      <div class="cmh-drawer-footer-logo">
        <div class="cmh-drawer-footer-logo-circle">
          {{ section.settings.logo | image_url: width: 100 | image_tag: alt: shop.name }}
        </div>
      </div>
    {% endif %}
    <div class="cmh-drawer-footer-item">
      <a href="/pages/profile">PROFILE</a>
    </div>
    <div class="cmh-drawer-footer-item">
      <a href="/account/login">LOGIN / SIGNUP</a>
    </div>
  </div>
</div>

<script>
  const cmhHamburger = document.getElementById('cmh-hamburger-toggle');
  const cmhDrawerOverlay = document.getElementById('cmh-drawer-overlay');
  const cmhDrawerMenu = document.getElementById('cmh-drawer-menu');
  const cmhDrawerClose = document.getElementById('cmh-drawer-close');
  const cmhShopNavItem = document.getElementById('cmh-shop-nav-item');
  const cmhMegaMenuOverlay = document.getElementById('cmh-mega-menu-overlay');

  function cmhOpenDrawer() {
    cmhDrawerOverlay.classList.add('cmh-active');
    cmhDrawerMenu.classList.add('cmh-active');
    document.body.classList.add('cmh-menu-open');
    document.body.style.overflow = 'hidden';
  }

  function cmhCloseDrawer() {
    cmhDrawerOverlay.classList.remove('cmh-active');
    cmhDrawerMenu.classList.remove('cmh-active');
    document.body.classList.remove('cmh-menu-open');
    document.body.style.overflow = '';
  }

  function cmhToggleMegaMenu() {
    const isActive = cmhShopNavItem.classList.contains('cmh-active');
    if (isActive) {
      cmhShopNavItem.classList.remove('cmh-active');
      cmhMegaMenuOverlay.classList.remove('cmh-show');
    } else {
      cmhShopNavItem.classList.add('cmh-active');
      cmhMegaMenuOverlay.classList.add('cmh-show');
    }
  }

  function cmhCloseMegaMenu() {
    cmhShopNavItem.classList.remove('cmh-active');
    cmhMegaMenuOverlay.classList.remove('cmh-show');
  }

  // Function to update cart count
  function cmhUpdateCartCount() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        const cartCountElement = document.getElementById('cmh-cart-count');
        if (cartCountElement) {
          cartCountElement.textContent = cart.item_count;
        }
      })
      .catch(error => console.error('Error updating cart count:', error));
  }

  // Listen for cart updates (works with Shopify's AJAX cart)
  document.addEventListener('DOMContentLoaded', function() {
    // Update cart count on page load
    cmhUpdateCartCount();

    // Listen for custom cart update events (if your theme triggers them)
    document.addEventListener('cart:updated', cmhUpdateCartCount);
    
    // Listen for Shopify Section Rendering API events
    document.addEventListener('shopify:section:load', cmhUpdateCartCount);
    
    // Fallback: periodically check for cart updates (optional, can be removed if events work)
    // setInterval(cmhUpdateCartCount, 3000);
  });

  // Intercept AJAX cart additions (works with most themes)
  const originalFetch = window.fetch;
  window.fetch = function(...args) {
    return originalFetch.apply(this, args).then(response => {
      // Check if this was a cart update request
      if (args[0] && (args[0].includes('/cart/add') || args[0].includes('/cart/change') || args[0].includes('/cart/update'))) {
        setTimeout(cmhUpdateCartCount, 100);
      }
      return response;
    });
  };

  // Hamburger menu
  cmhHamburger.addEventListener('click', cmhOpenDrawer);
  cmhDrawerClose.addEventListener('click', cmhCloseDrawer);
  cmhDrawerOverlay.addEventListener('click', cmhCloseDrawer);

  // Click to toggle mega menu
  cmhShopNavItem.querySelector('a').addEventListener('click', function(e) {
    e.preventDefault();
    cmhToggleMegaMenu();
  });

  // Close mega menu when clicking overlay
  cmhMegaMenuOverlay.addEventListener('click', cmhCloseMegaMenu);

  // Close on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      cmhCloseDrawer();
      cmhCloseMegaMenu();
    }
  });
</script>





<!-- Cart Drawer Styles - Matching Stretch Theme -->
