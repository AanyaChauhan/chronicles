<!-- Cart Drawer HTML -->
<div id="custom-cart-drawer" class="custom-cart-drawer">
  <div class="custom-cart-drawer-overlay"></div>
  <div class="custom-cart-drawer-content">
    <div class="custom-cart-drawer-header">
      <h2>Cart <span class="cart-count">(<span id="custom-cart-count">0</span>)</span></h2>
      <button class="custom-cart-drawer-close">×</button>
    </div>
    <div class="custom-cart-drawer-items" id="custom-cart-drawer-items">
      <div class="custom-cart-drawer-empty">
        <p>Your cart is currently empty.</p>
      </div>
    </div>
    <div class="custom-cart-drawer-footer" id="custom-cart-drawer-footer" style="display: none;">
      <div class="custom-cart-drawer-subtotal">
        <span>Total</span>
        <span class="custom-cart-drawer-total" id="custom-cart-drawer-total"></span>
      </div>
      <p class="custom-cart-drawer-note">Tax included. Shipping calculated at checkout.</p>
      <div class="custom-cart-drawer-buttons">
        <button class="custom-cart-drawer-checkout" onclick="window.location.href='/checkout'">Checkout</button>
      </div>
    </div>
  </div>
</div>

<!-- Cart Drawer JavaScript -->
<script>
  
(function() {
  const customCartDrawer = document.getElementById('custom-cart-drawer');
  const customCartDrawerClose = document.querySelector('.custom-cart-drawer-close');
  const customCartDrawerOverlay = document.querySelector('.custom-cart-drawer-overlay');
  const customCartDrawerItems = document.getElementById('custom-cart-drawer-items');
  const customCartDrawerFooter = document.getElementById('custom-cart-drawer-footer');
  const customCartDrawerTotal = document.getElementById('custom-cart-drawer-total');
  const customCartCount = document.getElementById('custom-cart-count');
  
  // Get money format from Shopify
  const moneyFormat = {{ shop.money_format | json }};
  
  // Function to format money
  function formatMoney(cents) {
    if (typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
      return Shopify.formatMoney(cents, moneyFormat);
    }
    
    // Fallback formatting
    let value = (cents / 100).toFixed(2);
    
    // Use the money format pattern
    if (moneyFormat) {
      return moneyFormat.replace(/\{\{\s*amount\s*\}\}/, value);
    }
    
    // Ultimate fallback
    return value;
  }
  
  // Function to open cart drawer
  function openCustomCartDrawer() {
    customCartDrawer.classList.add('active');
    document.body.style.overflow = 'hidden';
    loadCustomCart();
  }
  
  // Function to close cart drawer
  function closeCustomCartDrawer() {
    customCartDrawer.classList.remove('active');
    document.body.style.overflow = '';
  }
  
  // Function to load cart data
  async function loadCustomCart() {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();
      updateCustomCartDrawer(cart);
    } catch (error) {
      console.error('Error loading cart:', error);
      customCartDrawerItems.innerHTML = '<div class="custom-cart-drawer-empty"><p>Error loading cart</p></div>';
    }
  }
  
  // Function to update cart drawer content
  function updateCustomCartDrawer(cart) {
    // Update cart count
    if (customCartCount) {
      customCartCount.textContent = cart.item_count;
    }
    
    if (cart.item_count === 0) {
      customCartDrawerItems.innerHTML = '<div class="custom-cart-drawer-empty"><p>Your cart is currently empty.</p></div>';
      customCartDrawerFooter.style.display = 'none';
      return;
    }
    
    let itemsHTML = '';
    cart.items.forEach(item => {
      const itemTotal = item.final_line_price;
      const variantTitle = item.variant_title !== 'Default Title' ? item.variant_title : '';
      
      itemsHTML += `
        <div class="custom-cart-drawer-item" data-key="${item.key}">
          <div class="custom-cart-drawer-item-image">
            <img src="${item.featured_image ? item.featured_image.url : ''}" alt="${item.title}" loading="lazy">
          </div>
          <div class="custom-cart-drawer-item-details">
            <div class="custom-cart-drawer-item-top">
              <div class="custom-cart-drawer-item-info">
                <div class="custom-cart-drawer-item-title">${item.product_title}</div>
                ${variantTitle ? `<div class="custom-cart-drawer-item-variant">${variantTitle}</div>` : ''}
              </div>
              <div class="custom-cart-drawer-item-price">${formatMoney(itemTotal)}</div>
            </div>
            <div class="custom-cart-drawer-item-bottom">
              <div class="custom-cart-drawer-item-quantity">
                <button class="custom-cart-qty-minus" data-key="${item.key}" data-qty="${item.quantity}" aria-label="Decrease quantity">−</button>
                <span>${item.quantity}</span>
                <button class="custom-cart-qty-plus" data-key="${item.key}" data-qty="${item.quantity}" aria-label="Increase quantity">+</button>
              </div>
              <button class="custom-cart-drawer-item-remove" data-key="${item.key}">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3 3.5h10M5.5 3.5v-1a1 1 0 011-1h3a1 1 0 011 1v1M6.5 7v4M9.5 7v4M4 3.5h8v9a1 1 0 01-1 1H5a1 1 0 01-1-1v-9z"/>
                </svg>
                Remove
              </button>
            </div>
          </div>
        </div>
      `;
    });
    
    customCartDrawerItems.innerHTML = itemsHTML;
    customCartDrawerTotal.textContent = formatMoney(cart.total_price);
    customCartDrawerFooter.style.display = 'block';
    
    // Add event listeners for quantity buttons
    attachCustomQuantityListeners();
  }
  
  // Function to attach quantity button listeners
  function attachCustomQuantityListeners() {
    // Plus buttons
    document.querySelectorAll('.custom-cart-qty-plus').forEach(btn => {
      btn.addEventListener('click', function() {
        const key = this.dataset.key;
        const currentQty = parseInt(this.dataset.qty);
        updateCustomCartItemQuantity(key, currentQty + 1);
      });
    });
    
    // Minus buttons
    document.querySelectorAll('.custom-cart-qty-minus').forEach(btn => {
      btn.addEventListener('click', function() {
        const key = this.dataset.key;
        const currentQty = parseInt(this.dataset.qty);
        if (currentQty > 1) {
          updateCustomCartItemQuantity(key, currentQty - 1);
        }
      });
    });
    
    // Remove buttons
    document.querySelectorAll('.custom-cart-drawer-item-remove').forEach(btn => {
      btn.addEventListener('click', function() {
        const key = this.dataset.key;
        updateCustomCartItemQuantity(key, 0);
      });
    });
  }
  
  // Function to update cart item quantity
  async function updateCustomCartItemQuantity(key, quantity) {
    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: key,
          quantity: quantity
        })
      });
      
      const cart = await response.json();
      updateCustomCartDrawer(cart);
      
      // Update header cart count
      if (typeof cmhUpdateCartCount === 'function') {
        cmhUpdateCartCount();
      }
    } catch (error) {
      console.error('Error updating cart:', error);
    }
  }
  
  // Function to add item to cart
  async function addToCustomCart(formData) {
    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      });
      
      if (response.ok) {
        openCustomCartDrawer();
        // Update header cart count
        if (typeof cmhUpdateCartCount === 'function') {
          cmhUpdateCartCount();
        }
      } else {
        const error = await response.json();
        alert(error.description || 'Sorry, there was an error adding this item to your cart.');
      }
    } catch (error) {
      console.error('Error adding to cart:', error);
      alert('Sorry, there was an error adding this item to your cart.');
    }
  }
  
  // Intercept ALL form submissions for cart adds
  document.addEventListener('submit', function(e) {
    const form = e.target;
    
    // Check if this is a cart add form
    if (form && form.action && form.action.includes('/cart/add')) {
      e.preventDefault();
      e.stopPropagation();
      
      const formData = new FormData(form);
      addToCustomCart(formData);
    }
  }, true);
  
  // Also catch clicks on button-content (Stretch theme specific)
  document.addEventListener('click', function(e) {
    const target = e.target;
    
    // Check if clicked element is button-content or inside a submit button
    const buttonContent = target.closest('button-content');
    const submitButton = target.closest('button[type="submit"]');
    
    if (buttonContent || submitButton) {
      // Find the parent form
      const form = target.closest('form');
      
      if (form && form.action && form.action.includes('/cart/add')) {
        e.preventDefault();
        e.stopPropagation();
        
        const formData = new FormData(form);
        addToCustomCart(formData);
      }
    }
  }, true);
  
  // DO NOT intercept header cart link - let it go to /cart page naturally
  // The header cart link will work as normal
  
  // Close drawer events
  if (customCartDrawerClose) {
    customCartDrawerClose.addEventListener('click', closeCustomCartDrawer);
  }
  if (customCartDrawerOverlay) {
    customCartDrawerOverlay.addEventListener('click', closeCustomCartDrawer);
  }
  
  // Close on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && customCartDrawer.classList.contains('active')) {
      closeCustomCartDrawer();
    }
  });
  
  // Expose functions globally
  window.openCustomCartDrawer = openCustomCartDrawer;
  window.closeCustomCartDrawer = closeCustomCartDrawer;
})();
// Add the cart link handler for desktop below:
document.addEventListener('DOMContentLoaded', function() {
  var cartLink = document.getElementById('cmh-cart-link');
  if (cartLink) {
    cartLink.addEventListener('click', function(e) {
      if (window.innerWidth > 768) { // Only on desktop
        e.preventDefault();
        if (typeof openCustomCartDrawer === 'function') {
          openCustomCartDrawer();
        }
      }
      // On mobile, allow normal /cart page navigation
    });
  }
});
</script>








