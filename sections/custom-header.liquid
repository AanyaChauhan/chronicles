    visibility: visible;
    pointer-events: all;
  }

  .custom-cart-drawer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .custom-cart-drawer.active .custom-cart-drawer-overlay {
    opacity: 1;
  }

  .custom-cart-drawer-content {
