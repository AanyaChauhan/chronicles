    text-transform: none;
  }

  .custom-cart-drawer-header .cart-count {
    font-size: 28px;
  }

  .custom-cart-drawer-close {
    background: none;
    border: none;
    font-size: 32px;
    cursor: pointer;
    padding: 0;
    width: 40px;
    height: 40px;
    line-height: 1;
    color: #333;
    display: flex;
    align-items: center;
    justify-content: center;
