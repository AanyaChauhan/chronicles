<section class="coming-soon-wrapper{% if section.settings.invert_layout %} invert{% endif %}">
  <div class="coming-soon-image">
    {% if section.settings.main_image != blank %}
      <img src="{{ section.settings.main_image | img_url: '900x900' }}" alt="Coming Soon Image" />
    {% endif %}
  </div>
  <div class="coming-soon-content" style="background: {{ section.settings.right_bg_color }};">
    {% if section.settings.logo != blank %}
      <img class="logo" src="{{ section.settings.logo | img_url: '300x' }}" alt="{{ section.settings.alt_logo }}">
    {% endif %}
    <div class="heading" style="font-size: {{ section.settings.heading_font_size }}px; color: {{ section.settings.heading_color }};">
      {{ section.settings.heading }}
    </div>
    <div class="desc" style="font-size: {{ section.settings.content_font_size }}px; color: {{ section.settings.content_color }};">
      {{ section.settings.content_text }}
    </div>
    <div class="subscribe-block">
      <div class="input-head">{{ section.settings.input_heading }}</div>
      {% form 'contact', class: 'subscribe-form' %}
        {% if form.posted_successfully? %}
          <div class="thank-you-message show" style="color: {{ section.settings.thank_you_color }};">
            {{ section.settings.thank_you_message }}
          </div>
        {% else %}
          <div class="form-row">
            <input class="input-field" type="text" name="contact[first_name]" aria-label="First Name" placeholder="FIRST NAME" required>
            <input class="input-field" type="text" name="contact[last_name]" aria-label="Last Name" placeholder="LAST NAME" required>
          </div>
          <input class="input-email" type="email" name="contact[email]" aria-label="{{ section.settings.input_alt }}" placeholder="{{ section.settings.input_alt }}" required>
          <button type="submit">
            {% if section.settings.button_logo_show and section.settings.button_logo != blank %}
              <img class="button-logo" src="{{ section.settings.button_logo | img_url: '40x' }}" alt="Button Icon" />
            {% endif %}
            {{ section.settings.button_text }}
          </button>
        {% endif %}
        {% if form.errors %}
          <div class="error-message" style="color: #d02e2e;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
      {% endform %}
      {% unless form.posted_successfully? %}
        <div class="thank-you-message" style="color: {{ section.settings.thank_you_color }};">
          {{ section.settings.thank_you_message }}
        </div>
      {% endunless %}
    </div>
  </div>
</section>


<style>

.input-email::placeholder,
.input-field::placeholder{
  font-family: 'archivo', sans-serif;
}  

.coming-soon-wrapper {
  display: flex;
  height: 100vh;
  width: 100vw;
}
.coming-soon-wrapper .coming-soon-image {
  width: 46.5vw;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF6DC;
}
.coming-soon-wrapper .coming-soon-image img {
 width:100%;
  height: 100%;
  object-fit: cover;
  box-shadow: none;
  display: block;
}
.coming-soon-content {
  width: 58vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}
.coming-soon-content .logo {
  height: 116.74px;
  width:295.78px;
  margin-bottom: 75px;
}
.coming-soon-content .heading {
  font-family: 'Playfair Display';
  font-style: italic;
  line-height: 122%;
  margin: 0 0 10px 0;
  font-size: 64px;
}
.coming-soon-content .desc {
  font-family: 'archivo', sans-serif; 
  font-weight: 300; 
  text-align: center;
  margin-bottom: 75px;
  line-height: 1.51;
  width: 617.79px;
}
.subscribe-block {
  width: 100%;
  max-width: 420px;
}
.input-head {
  font-family: 'archivo', sans-serif; 
  font-weight: 300; 
  text-align: center;
  margin-bottom: 20px;
  color: #3C3B23;
  font-size: 16px;
}
.subscribe-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  justify-content: center;
}
.form-row {
  display: flex;
  gap: 10px;
}
.form-row .input-field {
  flex: 1;
  padding: 0 25px;
  font-size: 12px;
  font-weight: 300; 
  letter-spacing: 2px;
  border:none;
  border-radius: 0px;
  outline: none;
  height: 50px;
  background: #FFF6DC;
  border: 1px solid #494A2F;
  width: 205px;
}
.subscribe-form input[type="email"] {
  width: 100%;
  padding: 0 25px;
  font-size: 12px;
  font-weight: 300; 
  letter-spacing: 2px;
  border:none;
  border-radius: 0px;
  outline: none;
  height: 50px;
  background: #FFF6DC;
  border: 1px solid #494A2F;
}
.subscribe-form button {
  font-family: 'archivo', sans-serif;
  background: #323629;
  color: #FFF6DC;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 2px;
  padding: 0 24px;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50px;
  transition: background-color 0.3s ease;
}

.subscribe-form button:hover {
  background: #494A2F;
}

.subscribe-form .button-logo {
  height: 22px;
  margin-right: 5px;
}

.thank-you-message {
  font-family: 'archivo', sans-serif;
  font-weight: 600;
  font-style: italic;
  text-align: center;
  margin-top: 16px;
  font-size: 14px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.thank-you-message.show {
  opacity: 1;
  visibility: visible;
}

.error-message {
  font-family: 'archivo', sans-serif;
  font-weight: 400;
  text-align: center;
  margin-top: 16px;
  font-size: 14px;
}

.coming-soon-wrapper.invert {
  flex-direction: row-reverse;
}

@media (max-width: 900px) {
  .coming-soon-wrapper {
    flex-direction: column;
    min-height: 100svh;
    height: auto;
  }
 .coming-soon-wrapper .coming-soon-image {
    display:none;
  }
  .coming-soon-wrapper .coming-soon-image img {
    display: none !important;
  }
}

{% comment %} mobile optimization {% endcomment %}

@media (max-width: 768px) {
  .coming-soon-wrapper {
    flex-direction: column-reverse;
    height: 100svh;
    background: {{ section.settings.right_bg_color }};
    display: flex;
    align-content: center !important;
    justify-content: center;
  }
  
  .coming-soon-wrapper.invert {
    flex-direction: column;
  }
  
  .coming-soon-wrapper .coming-soon-image {
    display:none;
  }
  .coming-soon-wrapper .coming-soon-image img {
    display: none !important;
  }
  
  .coming-soon-content {
    width: 100%;
    padding: 0px 24px;
    text-align: center;
  }
  
  .coming-soon-content .logo {
    height: auto;
    width: 200px;
    max-width: 80%;
    margin-bottom: 40px;
  }
  
  .coming-soon-content .heading {
    font-size: 32px !important;
    margin: 0 0 20px 0;
    padding: 0 16px;
  }
  
  .coming-soon-content .desc {
    font-size: 12px !important;
    margin-bottom: 40px;
    padding: 0 16px;
    width: 100%;
    max-width: 100%;
  }
  
  .subscribe-block {
    width: 100%;
    max-width: 100%;
    padding: 0 16px;
  }
  
   .input-head {
    font-size: 14px;
    margin-bottom: 16px;
  }
  
  .subscribe-form {
    width: 100%;
    gap: 8px;
  }
  
  .form-row {
    gap: 8px;
  }
  
  .form-row .input-field {
    padding: 0 15px;
    font-size: 10px;
    height: 30px;
    width: 50px;
  }
  
  .subscribe-form input[type="email"] {
    padding: 0 15px;
    font-size: 10px;
    height: 30px;
  }
  
  .subscribe-form button {
    padding: 0 16px;
    font-size: 10px;
    height: 30px;
    justify-content: center;
  }

  .thank-you-message {
    font-size: 12px;
    margin-top: 12px;
  }
}

</style>

{% schema %}
{
  "name": "Custom Coming Soon",
  "settings": [
    {
      "type": "checkbox",
      "id": "invert_layout",
      "label": "Invert Image and Content"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "color",
      "id": "right_bg_color",
      "label": "Right Panel BG Color",
      "default": "#f7f3e7"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "alt_logo",
      "label": "Logo Alt Text",
      "default": "House of Thalpa Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Coming Soon"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size (px)",
      "min": 18,
      "max": 72,
      "step": 1,
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#3e4020"
    },
    {
      "type": "textarea",
      "id": "content_text",
      "label": "Content Text",
      "default": "We are crafting something timeless—a new collection that bridges heritage and modern ritual."
    },
    {
      "type": "range",
      "id": "content_font_size",
      "label": "Content Font Size (px)",
      "min": 12,
      "max": 36,
      "step": 1,
      "default": 18
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content Color",
      "default": "#24251f"
    },
    {
      "type": "text",
      "id": "input_heading",
      "label": "Input Heading",
      "default": "Subscribe For Updates"
    },
    {
      "type": "text",
      "id": "input_alt",
      "label": "Input Alt Text",
      "default": "Your Email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "image_picker",
      "id": "button_logo",
      "label": "Button Logo"
    },
    {
      "type": "checkbox",
      "id": "button_logo_show",
      "label": "Show Button Logo"
    },
    {
      "type": "text",
      "id": "thank_you_message",
      "label": "Thank You Message",
      "default": "Thanks for subscribing! We'll keep you updated."
    },
    {
      "type": "color",
      "id": "thank_you_color",
      "label": "Thank You Message Color",
      "default": "#3C3B23"
    }
  ],
  "presets": [
    {
      "name": "Custom Coming Soon"
    }
  ]
}
{% endschema %}