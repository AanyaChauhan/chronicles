<style>
  .trade-section {
    background-color: {{ section.settings.bg_color }};
    padding: 60px 40px;
    display: flex;
    gap: 83px;
    align-items: flex-end;
    max-width: 1400px;
    margin: 0 auto;
  }

  .trade-left-panel {
    flex: 1;
  }

  .trade-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    margin-bottom: 41px;
    font-family: 'Playfair Display', sans-serif;
    font-style: italic;
    font-weight: 400;
    line-height: 124%;
  }

  .trade-description {
    color: {{ section.settings.description_color }};
    font-size: {{ section.settings.description_size }}px;
    line-height: 151%;
  }

  .trade-description p{
    margin-bottom: 25px;
  }
  .trade-description p:last-child,
.trade-description p:nth-child(2) {
  margin-bottom: 10px;
}

  .trade-description ul {
    list-style: none;
    padding-left: 0;
    margin-inline-start: 0;
  }

  .trade-description ul li {
    position: relative;
    padding-left: 15px;
    margin-bottom: 8px;
  }

  .trade-description ul li::before {
    content: "–";
    position: absolute;
    left: 0;
  }

  .trade-right-panel {
    flex: 0 0 480px;
    background-color: {{ section.settings.box_color }};
    padding: 15px 25px;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .trade-box-content {
    color: {{ section.settings.content_color }};
    font-size: {{ section.settings.content_size }}px;
    line-height: 151%;
    flex: 1;
  }

  .trade-box-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 17px;
  }

  .trade-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 165.12px;
    height: 49.47px;
    border: 1px solid {{ section.settings.btn_color }};
    color: {{ section.settings.btn_color }};
    font-size: {{ section.settings.btn_size }}px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
    overflow: hidden;
    z-index: 1;
    transition: color 0.3s ease;
    cursor: pointer;
    background: transparent;
  }

  .trade-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background-color: #494A2F;
    z-index: -1;
    transition: left 0.3s ease;
  }

  .trade-btn:hover {
    color: #F6EAC8;
  }

  .trade-btn:hover::before {
    left: 0;
  }

  .trade-logo {
    width: 72.97px;
    height: 93.56px;
    object-fit: contain;
  }

  /* Popup Modal Styles */
  .trade-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.37);
    z-index: 9998;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .trade-popup-overlay.active {
    display: block;
    opacity: 1;
  }

  .trade-popup-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: none;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .trade-popup-container.active {
    display: block;
  }

  .trade-popup-content {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0px;
  }

  .trade-popup-form-wrapper {
    background-color: {{ section.settings.popup_bg_color }};
    max-width: 600px;
    width: 100%;
    height: calc(100vh - 80px);
    overflow-y: auto;
    padding: 40px 35px;
    position: relative;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .trade-popup-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: {{ section.settings.popup_text_color }};
    line-height: 1;
    padding: 5px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .trade-popup-close:hover {
    opacity: 0.6;
  }

  .trade-popup-close svg {
    width: 18.5px;
    height: 18.5px;
  }

  .trade-popup-title {
    font-size: {{ section.settings.popup_title_size }}px;
    color: {{ section.settings.popup_title_color }};
    margin-bottom: 33px;
    text-transform: uppercase;
    font-weight: 300;
  }

  .trade-popup-form {
    display: flex;
    flex-direction: column;
    gap: 33.5px;
  }

  .trade-form-row {
    display: block;
    gap: 20px;
  }

  .trade-form-row.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .trade-form-row.three-col {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
  }

  .trade-form-group {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .trade-form-label {
    font-size: {{ section.settings.popup_label_size }}px;
    color: {{ section.settings.popup_text_color }};
    margin-bottom: 10px;
    font-weight: 400;
  }

  .trade-form-input,
  .trade-form-select {
    border: none;
    border-bottom: 1px solid {{ section.settings.popup_text_color }};
    background: transparent !important;
    padding-bottom: 8px;
    font-size: {{ section.settings.popup_input_size }}px;
    color: {{ section.settings.popup_input_text_color }};
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
    border-radius: 0;
    box-shadow: none !important;
    width: 100%;
    min-width: 0;
  }
  .trade-form-group.email-group {
    margin-bottom: 11px;
  }

  .trade-form-input:focus,
  .trade-form-select:focus {
    border-bottom-color: #494A2F;
    background: transparent !important;
  }

  .trade-form-input:-webkit-autofill,
  .trade-form-input:-webkit-autofill:hover,
  .trade-form-input:-webkit-autofill:focus,
  .trade-form-input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px {{ section.settings.popup_bg_color }} inset !important;
    -webkit-text-fill-color: {{ section.settings.popup_input_text_color }} !important;
    transition: background-color 5000s ease-in-out 0s;
  }

  .trade-form-select:-webkit-autofill,
  .trade-form-select:-webkit-autofill:hover,
  .trade-form-select:-webkit-autofill:focus,
  .trade-form-select:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px {{ section.settings.popup_bg_color }} inset !important;
    -webkit-text-fill-color: {{ section.settings.popup_input_text_color }} !important;
    transition: background-color 5000s ease-in-out 0s;
  }

  .trade-form-select {
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-color: transparent !important;
    background-image: url("data:image/svg+xml,%3Csvg width='15' height='7.5' viewBox='0 0 16 9' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0.353516 0.353516L7.85352 7.85352L15.3535 0.353516' stroke='%23494A2F' stroke-width='1.5'/%3E%3C/svg%3E") !important;
    background-repeat: no-repeat !important;
    background-position: calc(100% - 8px) center !important;
    background-size: 16px 9px !important;
    padding-right: 35px !important;
    transition: border-color 0.2s ease;
    color-scheme: light;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
  }

  .trade-form-select:hover,
  .trade-form-select:focus,
  .trade-form-select:active,
  .trade-form-select[open] {
    background-color: transparent !important;
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='9' viewBox='0 0 16 9' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0.353516 0.353516L7.85352 7.85352L15.3535 0.353516' stroke='%23494A2F' stroke-width='1.5'/%3E%3C/svg%3E") !important;
    background-repeat: no-repeat !important;
    background-position: calc(100% - 8px) center !important;
    background-size: 16px 9px !important;
  }

  .trade-form-select::-ms-expand {
    display: none;
  }

  .trade-form-select:focus {
    outline: none;
  }

  .trade-form-group select {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
  }

  .trade-form-select option {
    background-color: {{ section.settings.popup_bg_color }};
    color: {{ section.settings.popup_text_color }};
    padding: 8px 12px;
  }

  .trade-form-select option:hover,
  .trade-form-select option:focus {
    background-color: #494A2F !important;
    background: #494A2F !important;
    color: {{ section.settings.popup_bg_color }} !important;
  }

  .trade-form-select option:checked,
  .trade-form-select option[selected] {
    background-color: #494A2F !important;
    background: #494A2F !important;
    color: {{ section.settings.popup_bg_color }} !important;
  }

  @media screen and (-webkit-min-device-pixel-ratio:0) {
    .trade-form-select option {
      background-color: {{ section.settings.popup_bg_color }};
      color: {{ section.settings.popup_text_color }};
    }
    
    .trade-form-select option:hover {
      background: #494A2F !important;
      color: {{ section.settings.popup_bg_color }} !important;
    }
    
    .trade-form-select option:checked {
      background: linear-gradient(#494A2F, #494A2F) !important;
      color: {{ section.settings.popup_bg_color }} !important;
    }
  }

  .trade-form-select:focus option:checked,
  .trade-form-select option:checked:hover {
    background: #494A2F !important;
    color: {{ section.settings.popup_bg_color }} !important;
  }

  .trade-form-checkbox-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .trade-form-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: {{ section.settings.popup_text_color }};
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    border: 1px solid {{ section.settings.popup_text_color }};
    background-color: #DC143C;
    position: relative;
  }

  .trade-form-checkbox:checked {
    background-color: {{ section.settings.popup_text_color }};
  }

  .trade-form-checkbox:checked::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: {{ section.settings.popup_bg_color }};
    font-size: 14px;
    font-weight: bold;
  }

  .trade-form-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: {{ section.settings.popup_text_color }};
    background-color: transparent;
  }

  .trade-form-checkbox-label {
    font-size: 14px;
    color: {{ section.settings.popup_text_color }};
    cursor: pointer;
    font-weight: 400;
  }

  .trade-form-section-label {
    font-size: {{ section.settings.popup_label_size }}px;
    color: {{ section.settings.popup_text_color }};
    margin-bottom: 10px;
    font-weight: 500;
  }

  .trade-form-submit {
    background-color: #494A2F;
    color: #FFF8E3;
    border: 1px solid #494A2F;
    padding: 15px 40px;
    font-size: {{ section.settings.popup_submit_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    align-self: flex-start;
    margin-top: 10px;
    position: relative;
    overflow: hidden;
    z-index: 1;
    transition: color 0.3s ease;
  }

  .trade-form-submit::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background-color: #FFF8E3;
    z-index: -1;
    transition: left 0.3s ease;
  }

  .trade-form-submit:hover {
    color: #494A2F;
  }

  .trade-form-submit:hover::before {
    left: 0;
  }

  .trade-form-success {
    display: none;
    padding: 15px;
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
    margin-bottom: 20px;
    text-align: center;
  }

  .trade-form-success.active {
    display: block;
  }

  body.trade-popup-open {
    overflow: hidden;
  }
  .busaddress{
    cursor: unset;
    margin-bottom: 17px;
  }

@media (max-width: 768px) {
  .trade-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.37);
    z-index: 9998;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .trade-popup-overlay.active {
    display: block;
    opacity: 1;
  }

  .trade-popup-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: none;
    overflow-y: auto;              /* Allow scrolling on container */
    -webkit-overflow-scrolling: touch;
  }

  .trade-popup-container.active {
    display: block;
  }

  .trade-popup-content {
    min-height: 100vh;             /* Full viewport height */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 0;               /* Top and bottom spacing */
    box-sizing: border-box;
  }

  .trade-popup-form-wrapper {
    background-color: {{ section.settings.popup_bg_color }};
    max-width: 100%;
    width: 100%;
    height: auto;                   /* Auto height, not fixed */
    max-height: calc(100vh - 80px); /* Maximum height */
    overflow-y: auto;               /* Scrollable if content exceeds */
    padding: 40px 25px;
    padding-bottom: 60px;
    position: relative;
    box-shadow: none;
    box-sizing: border-box;
    -webkit-overflow-scrolling: touch;
  }

  .trade-popup-form {
    padding-bottom: 0;
  }

  .trade-section {
    flex-direction: column;
    align-items: stretch;
    padding: 40px 20px;
    gap: 20px;
  }

  .trade-right-panel {
    flex: 1;
  }
  
  .trade-heading {
    font-size: 36px;
    margin-bottom: 30px;
  }
  
  .trade-description, .trade-box-content {
    font-size: 14px;
  }
  
  .trade-logo {
    width: 58px;
    height: 74.37px;
  }
  
  .trade-right-panel {
    padding: 18px;
    padding-bottom: 15px;
  }
  
  .trade-description ul li {
    margin-bottom: 0px;
  }

  .trade-popup-title {
    font-size: 24px;
  }
  
  .trade-form-label, .trade-form-input, .trade-form-select {
    font-size: 14px;
  }

  .trade-form-row.two-col,
  .trade-form-row.three-col {
    grid-template-columns: 1fr;
    gap: 25px;
  }
  
  .trade-form-group {
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }
  
  .trade-form-group select,
  .trade-form-select {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
  }
}
</style>

<div class="trade-section">
  <div class="trade-left-panel">
    <h2 class="trade-heading">{{ section.settings.heading_text }}</h2>
    <div class="trade-description">
      {{ section.settings.description_text }}
    </div>
  </div>

  <div class="trade-right-panel">
    <div class="trade-box-content">
      {{ section.settings.box_content }}
    </div>
    <div class="trade-box-footer">
      <button type="button" class="trade-btn" id="openTradePopup-{{ section.id }}">
        {{ section.settings.btn_text }}
      </button>
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | img_url: '120x120' }}" alt="Logo" class="trade-logo">
      {% endif %}
    </div>
  </div>
</div>

<!-- Popup Overlay -->
<div class="trade-popup-overlay" id="tradePopupOverlay-{{ section.id }}"></div>

<!-- Popup Container -->
<div class="trade-popup-container" id="tradePopupContainer-{{ section.id }}">
  <div class="trade-popup-content">
    <div class="trade-popup-form-wrapper">
      <button type="button" class="trade-popup-close" id="closeTradePopup-{{ section.id }}">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M19.5 0.5L0.5 18.5M0.5 0.5L19.5 18.5" stroke="#494A2F" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <h2 class="trade-popup-title">{{ section.settings.popup_title }}</h2>
      
      <div class="trade-form-success" id="tradeFormSuccess-{{ section.id }}">
        Thank you! Your trade application has been submitted successfully.
      </div>

      {% form 'contact', id: 'tradeApplicationForm' %}
        <input type="hidden" name="contact[Form Type]" value="Trade Application">
        <input type="hidden" name="contact[subject]" value="New Trade Application - {{ shop.name }}">
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="return_to" value="{{ request.path }}?trade_posted=true#tradeApplicationForm">
        
        <div class="trade-popup-form">
          <div class="trade-form-row two-col">
            <div class="trade-form-group">
              <label class="trade-form-label" for="firstName-{{ section.id }}">First Name *</label>
              <input type="text" id="firstName-{{ section.id }}" name="contact[First Name]" class="trade-form-input" required>
            </div>
            <div class="trade-form-group">
              <label class="trade-form-label" for="lastName-{{ section.id }}">Last Name *</label>
              <input type="text" id="lastName-{{ section.id }}" name="contact[Last Name]" class="trade-form-input" required>
            </div>
          </div>

          <div class="trade-form-group">
            <label class="trade-form-label" for="businessName-{{ section.id }}">Business Name *</label>
            <input type="text" id="businessName-{{ section.id }}" name="contact[Business Name]" class="trade-form-input" required>
          </div>

          <div class="trade-form-group">
            <label class="trade-form-label" for="businessType-{{ section.id }}">Type of Business *</label>
            <input type="text" id="businessType-{{ section.id }}" name="contact[Type of Business]" class="trade-form-input" required>
          </div>

          <div class="trade-form-group">
            <label class="trade-form-label" for="businessWebsite-{{ section.id }}">Business Website / Instagram *</label>
            <input type="text" id="businessWebsite-{{ section.id }}" name="contact[Business Website/Instagram]" class="trade-form-input" required>
          </div>

          <div class="trade-form-row">
            <div class="trade-form-group email-group">
              <label class="trade-form-label" for="email-{{ section.id }}">Email *</label>
              <input type="email" id="email-{{ section.id }}" name="contact[email]" class="trade-form-input" required>
            </div>
            <div class="trade-form-group">
              <div class="trade-form-checkbox-wrapper">
                <input type="checkbox" id="optIn-{{ section.id }}" name="contact[Opt-in for news]" class="trade-form-checkbox" value="Yes">
                <label class="trade-form-checkbox-label" for="optIn-{{ section.id }}">Opt-in for news and updates</label>
              </div>
            </div>
          </div>

          <div class="trade-form-group">
            <label class="trade-form-section-label busaddress" for="country-{{ section.id }}">Business Address *</label>
            <label class="trade-form-section-label" for="country-{{ section.id }}">Country *</label>
            <select id="country-{{ section.id }}" name="contact[Country]" class="trade-form-select" required>
              <option value="">Select Country</option>
              <option value="United States">United States</option>
              <option value="Canada">Canada</option>
              <option value="United Kingdom">United Kingdom</option>
              <option value="Australia">Australia</option>
              <option value="Germany">Germany</option>
              <option value="France">France</option>
              <option value="India">India</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="trade-form-group">
            <label class="trade-form-label" for="address1-{{ section.id }}">Address Line 1 *</label>
            <input type="text" id="address1-{{ section.id }}" name="contact[Address Line 1]" class="trade-form-input" required>
          </div>

          <div class="trade-form-group">
            <label class="trade-form-label" for="address2-{{ section.id }}">Address Line 2</label>
            <input type="text" id="address2-{{ section.id }}" name="contact[Address Line 2]" class="trade-form-input">
          </div>

          <div class="trade-form-row three-col">
            <div class="trade-form-group">
              <label class="trade-form-label" for="city-{{ section.id }}">City *</label>
              <input type="text" id="city-{{ section.id }}" name="contact[City]" class="trade-form-input" required>
            </div>
            <div class="trade-form-group">
              <label class="trade-form-label" for="state-{{ section.id }}">State *</label>
              <input type="text" id="state-{{ section.id }}" name="contact[State]" class="trade-form-input" required>
            </div>
            <div class="trade-form-group">
              <label class="trade-form-label" for="zipcode-{{ section.id }}">Zipcode *</label>
              <input type="text" id="zipcode-{{ section.id }}" name="contact[Zipcode]" class="trade-form-input" required>
            </div>
          </div>

          <div class="trade-form-group">
            <label class="trade-form-label" for="phone-{{ section.id }}">Phone Number *</label>
            <input type="tel" id="phone-{{ section.id }}" name="contact[Phone Number]" class="trade-form-input" required>
          </div>

          <div class="trade-form-group">
            <label class="trade-form-label" for="taxId-{{ section.id }}">Tax ID/ EIN *</label>
            <input type="text" id="taxId-{{ section.id }}" name="contact[Tax ID/EIN]" class="trade-form-input" required>
          </div>

          <button type="submit" class="trade-form-submit">{{ section.settings.popup_submit_text }}</button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const openBtn = document.getElementById('openTradePopup-' + sectionId);
  const closeBtn = document.getElementById('closeTradePopup-' + sectionId);
  const overlay = document.getElementById('tradePopupOverlay-' + sectionId);
  const container = document.getElementById('tradePopupContainer-' + sectionId);
  const form = container.querySelector('form');
  const successMsg = document.getElementById('tradeFormSuccess-' + sectionId);

  function openPopup() {
    overlay.classList.add('active');
    container.classList.add('active');
    document.body.classList.add('trade-popup-open');
  }

  function closePopup() {
    overlay.classList.remove('active');
    container.classList.remove('active');
    document.body.classList.remove('trade-popup-open');
  }

  openBtn.addEventListener('click', openPopup);
  closeBtn.addEventListener('click', closePopup);
  overlay.addEventListener('click', closePopup);

  if (window.location.search.includes('trade_posted=true') && window.location.hash === '#tradeApplicationForm') {
    openPopup();
    successMsg.classList.add('active');
    form.style.display = 'none';
    setTimeout(function() {
      closePopup();
      form.style.display = 'block';
      successMsg.classList.remove('active');
      form.reset();
      if (window.history.replaceState) {
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    }, 3000);
  }
})();
</script>

