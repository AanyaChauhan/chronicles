<style>
  .heritage-highlight-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: 60px 40px 60px 0px;
  }

  .heritage-highlight-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48.53px;
    align-items: stretch;
  }

  .heritage-image-wrapper {
    overflow: hidden;
    position: relative;
  }

  .heritage-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .heritage-image-wrapper:hover img {
    transform: scale(1.1);
  }

  .heritage-video-thumbnail {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 330.5px;
    height: 330.5px;
    z-index: 2;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .heritage-video-thumbnail:hover {
    transform: translate(-50%, -50%) scale(1.05);
  }

  .heritage-video-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .heritage-thumbnail-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    padding: 0;
    z-index: 3;
  }

  .heritage-thumbnail-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .heritage-thumbnail-play-btn svg,
  .heritage-thumbnail-play-btn img {
    width: 50.98px;
    height: 60.75px;
    fill: #D9D9D9;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }

  /* Video Modal Styles */
  .heritage-video-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .heritage-video-modal.active {
    display: flex;
    opacity: 1;
  }

  .heritage-modal-content {
    position: relative;
    width: 90%;
    max-width: 1200px;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .heritage-modal-video {
    width: 100%;
    height: auto;
    max-height: 90vh;
    object-fit: contain;
  }

  .heritage-modal-close {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 40px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    z-index: 10;
  }

  .heritage-modal-close:hover {
    transform: scale(1.2);
  }

  .heritage-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 33px 0px;
  }

  .heritage-title {
    font-size: {{ section.settings.title_font_size }}px;
    color: {{ section.settings.title_color }};
    font-family: 'Playfair Display', sans-serif;
    font-style: italic;
    line-height: 124%;
    font-weight: 400;
    width: 650px;
  }

  .heritage-bottom-content {
    margin-top: auto;
  }

  .heritage-description {
    font-size: {{ section.settings.desc_font_size }}px;
    color: {{ section.settings.desc_color }};
    font-family: 'Archivo', sans-serif;
    line-height: 151%;
    font-weight: 300;
    margin-bottom: 30.64px;
  }

  .heritage-btn {
    display: inline-block;
    padding: 12px 18px;
    font-size: {{ section.settings.btn_font_size }}px;
    color: {{ section.settings.btn_color }};
    border: 0.5px solid {{ section.settings.btn_color }};
    font-family: 'Archivo', sans-serif;
    line-height: 24px;
    font-weight: 300;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: color 0.4s ease;
    align-self: flex-start;
    z-index: 1;
  }

  .heritage-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0%;
    height: 100%;
    background-color: {{ section.settings.btn_color }};
    transition: width 0.4s ease;
    z-index: -1;
  }

  .heritage-btn:hover::before {
    width: 100%;
  }

  .heritage-btn:hover {
    color: {{ section.settings.bg_color }};
  }

  @media (max-width: 768px) {
    .heritage-highlight-{{ section.id }} {
      padding: 40px 20px;
    }

    .heritage-highlight-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .heritage-content {
      padding: 20px;
    }

    .heritage-title {
      width: 100%;
    }

    .heritage-description {
      width: 100%;
    }

    .heritage-video-thumbnail {
      width: 250px;
      height: 250px;
    }

    .heritage-modal-content {
      width: 95%;
    }

    .heritage-modal-close {
      top: -50px;
      font-size: 35px;
    }
  }
</style>

<div class="heritage-highlight-{{ section.id }}">
  <div class="heritage-highlight-container">
    <div class="heritage-image-wrapper">
      {% if section.settings.main_image %}
        <img src="{{ section.settings.main_image | img_url: 'master' }}" alt="{{ section.settings.title_text }}">
      {% else %}
        {{ 'image' | placeholder_svg_tag }}
      {% endif %}

      {% if section.settings.main_video != blank %}
        <div class="heritage-video-thumbnail" id="video-thumbnail-{{ section.id }}">
          {% if section.settings.video_thumbnail %}
            <img src="{{ section.settings.video_thumbnail | img_url: 'master' }}" alt="Video thumbnail">
          {% else %}
            <img src="{{ section.settings.main_image | img_url: 'master' }}" alt="Video thumbnail">
          {% endif %}
          
          <button 
            class="heritage-thumbnail-play-btn"
            aria-label="Play video"
          >
            {% if section.settings.play_icon != blank %}
              <img src="{{ section.settings.play_icon | img_url: 'master' }}" alt="Play">
            {% else %}
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 5v14l11-7z"/>
              </svg>
            {% endif %}
          </button>
        </div>
      {% endif %}
    </div>

    <div class="heritage-content">
      <div class="heritage-top-content">
        {% if section.settings.title_text != blank %}
          <h2 class="heritage-title">{{ section.settings.title_text }}</h2>
        {% endif %}
      </div>

      <div class="heritage-bottom-content">
        {% if section.settings.desc_text != blank %}
          <div class="heritage-description">{{ section.settings.desc_text }}</div>
        {% endif %}

        {% if section.settings.btn_toggle %}
          <a href="{{ section.settings.btn_link }}" class="heritage-btn">
            {{ section.settings.btn_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if section.settings.main_video != blank %}
  <div class="heritage-video-modal" id="video-modal-{{ section.id }}">
    <div class="heritage-modal-content">
      <button class="heritage-modal-close" id="close-modal-{{ section.id }}" aria-label="Close video">
        &times;
      </button>
      <video 
        class="heritage-modal-video" 
        id="modal-video-{{ section.id }}"
        controls
        playsinline
        preload="metadata"
      >
        {% for source in section.settings.main_video.sources %}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {% endfor %}
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
{% endif %}

<script>
  (function() {
    const thumbnail = document.getElementById('video-thumbnail-{{ section.id }}');
    const modal = document.getElementById('video-modal-{{ section.id }}');
    const modalVideo = document.getElementById('modal-video-{{ section.id }}');
    const closeBtn = document.getElementById('close-modal-{{ section.id }}');
    
    if (thumbnail && modal && modalVideo) {
      // Open modal on thumbnail click
      thumbnail.addEventListener('click', function() {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        modalVideo.play();
      });
      
      // Close modal on close button click
      if (closeBtn) {
        closeBtn.addEventListener('click', function() {
          modal.classList.remove('active');
          document.body.style.overflow = '';
          modalVideo.pause();
          modalVideo.currentTime = 0;
        });
      }
      
      // Close modal on background click
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          modal.classList.remove('active');
          document.body.style.overflow = '';
          modalVideo.pause();
          modalVideo.currentTime = 0;
        }
      });
      
      // Close modal on ESC key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('active')) {
          modal.classList.remove('active');
          document.body.style.overflow = '';
          modalVideo.pause();
          modalVideo.currentTime = 0;
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Custom Heritage Highlight",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f1e8"
    },
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "video",
      "id": "main_video",
      "label": "Video",
      "info": "Upload a video to display in modal popup"
    },
    {
      "type": "image_picker",
      "id": "video_thumbnail",
      "label": "Video Thumbnail",
      "info": "Custom thumbnail image for video (optional - uses main image if not set)"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image",
      "info": "Background image"
    },
    {
      "type": "header",
      "content": "Video Control Icons"
    },
    {
      "type": "image_picker",
      "id": "play_icon",
      "label": "Play Icon",
      "info": "Custom play button icon (optional)"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title Text",
      "default": "Where Heritage Lives in Handwork"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size",
      "min": 20,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#333333"
    },
    {
      "type": "textarea",
      "id": "desc_text",
      "label": "Description Text",
      "default": "At House of Thalpa, every creation begins with heritage and ends with meaning. Rooted in centuries-old artistry like Bidriware and handwoven textiles, our pieces are more than décor—they are keys to memory, ritual, and culture. By bridging Indian craftsmanship with contemporary design, At House of Thalpa, every creation begins with heritage and ends with meaning."
    },
    {
      "type": "range",
      "id": "desc_font_size",
      "label": "Description Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "checkbox",
      "id": "btn_toggle",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "DISCOVER PIECES"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "btn_font_size",
      "label": "Button Font Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Color",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Custom Heritage Highlight"
    }
  ]
}
{% endschema %}