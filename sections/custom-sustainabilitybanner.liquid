<section class="hero-text-overlay" data-section-id="{{ section.id }}">
  <div class="hero-media-container">
    {% if section.settings.media_type == 'video' and section.settings.background_video %}
      <video 
        class="hero-background-video" 
        autoplay 
        muted 
        loop 
        playsinline
        preload="auto"
        poster="{% if section.settings.background_image %}{{ section.settings.background_image | image_url: width: 1920 }}{% endif %}">
        {% for source in section.settings.background_video.sources %}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {% endfor %}
        {% if section.settings.background_image %}
          <img src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="{{ section.settings.background_image.alt | escape }}">
        {% endif %}
      </video>
    {% elsif section.settings.background_image %}
      <img 
        class="hero-background-image" 
        src="{{ section.settings.background_image | image_url: width: 1920 }}" 
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="lazy">
    {% else %}
      <div class="hero-background-placeholder"></div>
    {% endif %}
  </div>

  {% if section.settings.show_text_box %}
    <div class="hero-text-box-wrapper">
      <div class="hero-text-box">
        {% if section.settings.text_box_bg_texture %}
          <div class="text-box-bg-texture" style="background-image: url('{{ section.settings.text_box_bg_texture | image_url }}');"></div>
        {% endif %}
        <div class="text-box-content">
          {% if section.settings.heading != blank %}
            <h2 class="text-box-heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <p class="text-box-description">{{ section.settings.description }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

<style>
  .hero-text-overlay {
    position: relative;
    width: 100%;
    height: 719px;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-media-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-background-image,
  .hero-background-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-background-placeholder {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
  }

  .hero-text-box-wrapper {
    position: absolute;
    left: 50%;
    bottom: -80px;
    transform: translateX(-50%);
    width: 600px;
    max-width: 600px;
    z-index: 5;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-text-box {
    position: relative;
    z-index: 2;
    background: #A6DCF6;
    border-radius: 16px;
    margin: 0 auto;
    min-width: 855px;
    width: 100%;
    border: 9px solid #71B6D7;
    pointer-events: auto;
    box-sizing: border-box;
  }

  .text-box-bg-texture {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .text-box-content {
    position: relative;
    z-index: 2;
  }

  .text-box-heading {
    font-family: 'Givonic', sans-serif;
    font-weight: 400;
    font-size: {{ section.settings.heading_font_size }}px;
    color: {{ section.settings.heading_color }};
    text-align: center;
    margin: 0;
    padding: 40px 85px 40px 85px;
    line-height: 40px;
    text-transform: uppercase;
  }

  .text-box-description {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: {{ section.settings.description_font_size }}px;
    color: {{ section.settings.description_color }};
    text-align: center;
    margin:0;
    padding:  0 60px 40px 60px;
    line-height: 28px;
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .hero-text-overlay {
      height: 500px;
    }
    
    .hero-text-box-wrapper {
      bottom: -60px;
      width: 90%;
      max-width: 500px;
    }
    
    .hero-text-box {
      padding: 35px 40px;
      margin: 0 20px;
      border-radius: 10px;
    }
    
    .text-box-heading {
      font-size: calc({{ section.settings.heading_font_size }}px * 0.8);
      margin-bottom: 15px;
    }
    
    .text-box-description {
      font-size: calc({{ section.settings.description_font_size }}px * 0.9);
    }
  }

  @media (max-width: 480px) {
    .hero-text-overlay {
      height: 400px;
    }
    
    .hero-text-box-wrapper {
      bottom: -50px;
      width: 95%;
      max-width: 350px;
    }
    
    .hero-text-box {
      padding: 25px 30px;
      margin: 0 15px;
      border-radius: 8px;
    }
    
    .text-box-heading {
      font-size: calc({{ section.settings.heading_font_size }}px * 0.7);
      margin-bottom: 12px;
      line-height: 1.2;
    }
    
    .text-box-description {
      font-size: calc({{ section.settings.description_font_size }}px * 0.8);
      line-height: 1.5;
    }
  }

  /* Additional media queries for very small screens */
  @media (max-width: 360px) {
    .hero-text-box {
      padding: 20px 15px;
    }
    
    .text-box-heading {
      font-size: calc({{ section.settings.heading_font_size }}px * 0.6);
    }
    
    .text-box-description {
      font-size: calc({{ section.settings.description_font_size }}px * 0.75);
    }
  }
</style>

{% schema %}
{
  "name": "Hero Text Overlay",
  "tag": "section",
  "class": "hero-text-overlay-section",
  "settings": [
    {
      "type": "header",
      "content": "Background Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Background Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background Video"
    },
    {
      "type": "header",
      "content": "Text Box Settings"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "label": "Show Text Box",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "text_box_bg_texture",
      "label": "Text Box Background Texture"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STAYING TRUE – TO THE PLANET, TO PEOPLE, TO OUR PROMISE."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "At True Silver, our journey is rooted not just in creating beautiful jewellery, but in crafting a better tomorrow. From how we source our materials to how we treat our people and planet, we believe that true beauty should never come at the cost of the environment or ethics."
    },
    {
      "type": "header",
      "content": "Text Styling"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size",
      "min": 16,
      "max": 60,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Description Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Hero Text Overlay"
    }
  ]
}
{% endschema %}